---
// Página de industria. Las tres rutas por locale son el mismo componente:
// aquí solo se fija el locale y se resuelven los slugs.

import Base from '../../layouts/Base.astro';
import Industria from '../../components/Industria.astro';
import type { Locale } from '../../i18n/index';
import { INDUSTRIAS, contenido } from '../../lib/industrias';

const locale: Locale = 'es';

export function getStaticPaths() {
  return INDUSTRIAS.map((industria) => ({
    params: { slug: industria.slug },
    props: { industria },
  }));
}

const { industria } = Astro.props;
const { txt } = contenido(industria, locale);
---

<Base
  title={txt.__title}
  description={txt.hero_lead}
  locale={locale}
  rutaEs={`industrias/${industria.slug}`}
>
  <Industria locale={locale} industria={industria} />
</Base>
