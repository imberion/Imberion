---
import type { Locale } from '../i18n/index';
import { LOCALES_RUTA, LOCALE_RAIZ, ruta, urlAbsoluta } from '../lib/rutas';
import comun from '../i18n/content/common.json';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteScript from '../components/SiteScript.astro';

// shell.css trae el layout (reset, .container, nav fijo, pie) y site.css el
// skin vendorizado del sitio actual. El orden importa: el skin va después.
import '../styles/shell.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Segmento canónico en español de esta página. '' es el home. */
  rutaEs?: string;
}

const {
  title,
  description,
  locale = (Astro.currentLocale as Locale) ?? LOCALE_RAIZ,
  rutaEs = '',
} = Astro.props;

const c = comun[locale];
const origen = Astro.site?.origin ?? 'https://imberion.com';
const canonical = urlAbsoluta(origen, ruta(locale, rutaEs));
const alternas = LOCALES_RUTA.map((l) => ({
  hreflang: l,
  href: urlAbsoluta(origen, ruta(l, rutaEs)),
}));
---

<html lang={locale} data-imberion-site="v2">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={urlAbsoluta(origen, ruta(LOCALE_RAIZ, rutaEs))} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{c.skip_to_content}</a>
    <Nav locale={locale} rutaEs={rutaEs} />
    <main id="contenido">
      <slot />
    </main>
    <Footer locale={locale} />
    <SiteScript />
  </body>
</html>
