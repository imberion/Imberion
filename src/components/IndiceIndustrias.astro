---
// Índice de industrias: el hero de página interior y las nueve industrias como
// una lista numerada a todo el ancho, cada una con su foto de sector.
//
// Cada fila toma su bajada del hero_lead de la industria, así que el índice no
// mantiene una segunda copia de esos textos. Las industrias en borrador no
// entran: INDUSTRIAS ya las filtra.

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/index';
import { ruta } from '../lib/rutas';
import comun from '../i18n/content/common.json';
import { INDUSTRIAS, contenido, titulo } from '../lib/industrias';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = comun[locale];

// Fotos de sector (1600x1000, motion blur horizontal). Ver el README de la carpeta.
const fotos = import.meta.glob<ImageMetadata>('../assets/industrias/*.jpg', {
  import: 'default',
  eager: true,
});

const alts = c.industrias_foto_alt as Record<string, string>;

const filas = INDUSTRIAS.map((ind, i) => {
  const clave = `../assets/industrias/${ind.slug}.jpg`;
  const foto = fotos[clave];
  if (!foto) {
    throw new Error(
      `industrias: falta la foto de sector de ${ind.slug}. Se esperaba src/assets/industrias/${ind.slug}.jpg.`
    );
  }
  const alt = alts?.[ind.slug];
  if (!alt) {
    throw new Error(
      `industrias: falta el alt de la foto de ${ind.slug} (${locale}) en "industrias_foto_alt" de src/i18n/content/common.json.`
    );
  }
  return {
    alt,
    slug: ind.slug,
    num: String(i + 1).padStart(2, '0'),
    nombre: titulo(ind, locale),
    bajada: contenido(ind, locale).txt.hero_lead,
    href: ruta(locale, `industrias/${ind.slug}`),
    foto,
  };
});
---

<section class="page-hero">
  <div class="page-hero-bg"></div>
  <div class="page-hero-content">
    <div class="eyebrow">Imberion</div>
    <h1>{c.industrias_h1}</h1>
    <p class="lead">{c.industrias_lead}</p>
  </div>
</section>

<section class="ind-seccion">
  <div class="container">
    <ol class="ind-lista">
      {
        filas.map((f, i) => (
          <li class="ind-item">
            <a class="ind-fila" href={f.href}>
              <span class="ind-num" aria-hidden="true">
                {f.num}
              </span>
              <h2 class="ind-nombre">{f.nombre}</h2>
              <span class="ind-bajada">
                <span class="ind-linea">{f.bajada}</span>
                <span class="ind-cta">
                  {c.ver_industria} <span aria-hidden="true">→</span>
                </span>
              </span>
              <span class="ind-foto">
                <Image
                  src={f.foto}
                  alt={f.alt}
                  widths={[780, 1560]}
                  sizes="(max-width: 600px) 92vw, (max-width: 1080px) 34vw, 42vw"
                  format="webp"
                  quality={62}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding={i === 0 ? 'sync' : 'async'}
                />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ind-seccion { padding: 96px 0 120px; }
  .page-hero .lead { font-size: clamp(1.05rem, 1.6vw, 1.2rem); line-height: 1.7; }
  .page-hero .eyebrow { text-transform: uppercase; }

  .ind-lista { list-style: none; border-top: 1px solid var(--navy-12); }
  .ind-item { border-bottom: 1px solid var(--navy-12); }

  /* La fila es la unidad: número, nombre, la línea de casos de uso y la foto
     del sector. La columna de foto se lleva ~42 % del ancho de la fila y crece
     con ella (fr, no vw), porque en este patrón la imagen manda: a 420 px fijos
     se leía como miniatura al lado del texto. */
  .ind-fila {
    display: grid;
    grid-template-columns:
      4.5rem
      minmax(240px, 0.75fr)
      minmax(0, 1.1fr)
      minmax(360px, 1.72fr);
    align-items: center;
    gap: clamp(20px, 2.4vw, 56px);
    padding: clamp(26px, 2.2vw, 40px) 0;
    transition: background 0.35s var(--ease), padding-left 0.35s var(--ease);
  }
  .ind-fila:hover { background: var(--white); padding-left: clamp(0px, 1vw, 20px); }

  /* Cifra suelta: DM Sans, tabular. Una letra no dice nada; el índice sí. */
  .ind-num {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--navy-40);
    font-variant-numeric: tabular-nums;
    transition: color 0.25s var(--ease);
  }
  .ind-fila:hover .ind-num { color: var(--navy); }

  .ind-nombre {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.1vw, 2.8rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--navy);
    /* "Telecomunicaciones" es una sola palabra más ancha que su columna: sin
       esto se montaba encima de la bajada. */
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .ind-bajada { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .ind-linea {
    font-family: var(--font-sans);
    font-size: clamp(13.5px, 0.85vw, 15.5px);
    line-height: 1.65;
    color: var(--navy-72);
  }
  .ind-cta {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray-blue);
    display: inline-flex;
    gap: 8px;
    transition: gap 0.3s var(--ease), color 0.25s var(--ease);
  }
  .ind-fila:hover .ind-cta { color: var(--navy); gap: 12px; }

  /* Proporción fija 16:10, la misma del archivo: object-fit cover recorta pero
     nunca deforma. El navy encima une las nueve fotos en una sola familia y se
     retira al pasar el cursor. */
  .ind-foto {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper-alt);
  }
  .ind-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Las nueve fotos llegan con exposiciones distintas; el mismo filtro y el
       mismo velo navy las dejan leyéndose como una sola familia. */
    filter: saturate(0.62) contrast(1.06) brightness(0.94);
    transform: scale(1.01);
    transition: transform 0.7s var(--ease), filter 0.5s var(--ease);
  }
  .ind-foto::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--navy);
    opacity: 0.24;
    mix-blend-mode: multiply;
    transition: opacity 0.5s var(--ease);
  }
  .ind-fila:hover .ind-foto :global(img) { transform: scale(1.05); filter: saturate(0.95) contrast(1.02) brightness(1); }
  .ind-fila:hover .ind-foto::after { opacity: 0.05; }

  @media (max-width: 1080px) {
    .ind-fila {
      grid-template-columns: 3rem minmax(0, 1fr) minmax(200px, 0.85fr);
      grid-template-areas:
        "num nombre foto"
        "num bajada foto";
      align-items: start;
      row-gap: 12px;
    }
    .ind-num { grid-area: num; padding-top: 0.5em; }
    .ind-nombre { grid-area: nombre; }
    .ind-bajada { grid-area: bajada; }
    .ind-foto { grid-area: foto; align-self: center; }
  }

  @media (max-width: 600px) {
    .ind-seccion { padding: 60px 0 76px; }
    .ind-fila {
      grid-template-columns: 1fr;
      grid-template-areas:
        "foto"
        "num"
        "nombre"
        "bajada";
      gap: 12px;
      padding: 26px 0 30px;
    }
    .ind-num { padding-top: 8px; }
    .ind-fila:hover { padding-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ind-fila,
    .ind-num,
    .ind-cta,
    .ind-foto::after,
    .ind-foto :global(img) { transition: none; }
    .ind-fila:hover .ind-foto :global(img) { transform: scale(1.01); }
  }
</style>
