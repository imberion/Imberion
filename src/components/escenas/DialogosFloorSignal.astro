---
// Diálogos de valor y Training Signal en la página de Floor Signal para ropa y calzado (2026-11-01).
// Barra de cifras de la semana, tres frases literales con veredicto y resultado, la ficha individual
// de un vendedor y el ciclo con Training Signal. Rodrigo unió los dos bloques y pidió que la práctica
// con cliente simulado se abra en la ficha de Training Signal, no dentro de esta página.
// Regla de Rodrigo para este giro: comunicar la promoción vigente cuenta como buena práctica (el precio
// es el mismo para todos); nunca se pone como error del vendedor.
// El bloque lleva `data-dialogo`: las frases son habla citada en tienda, el "usted" es del personaje.

interface Props { contenido: Record<string, any> }
const { contenido: d } = Astro.props;
---

<div class="dfs" data-dialogo>
  <div class="dfs-barra">
    {d.barra.map((b: string[]) => <div><b>{b[0]}</b><span>{b[1]}</span></div>)}
  </div>

  <div class="dfs-cuerpo">
    <div class="dfs-frases">
      <h4>{d.frases_k}</h4>
      {d.frases.map((f: any) => (
        <article class={`dfs-frase ${f.tipo}`}>
          <header><span class="dfs-quien">{f.quien}</span><span class="dfs-ver">{f.veredicto}</span></header>
          {f.cliente && <p class="dfs-cliente"><span>Cliente:</span> {f.cliente}</p>}
          <p class="dfs-texto">{f.cliente && <span>Vendedor:</span>} {f.texto}</p>
          {f.nota && <p class="dfs-nota">{f.nota}</p>}
          <p class="dfs-res">{f.resultado}</p>
        </article>
      ))}
    </div>

    <div class="dfs-lado">
      <section class="dfs-ficha">
        <h4>{d.ficha_k}</h4>
        <p class="dfs-ficha-nota">{d.ficha_nota}</p>
        <dl>{d.ficha.map((f: string[]) => <div><dt>{f[0]}</dt><dd>{f[1]}</dd></div>)}</dl>
        <p class="dfs-k">{d.ficha_falta_k}</p>
        <ul>{d.ficha_falta.map((f: string) => <li>{f}</li>)}</ul>
        <p class="dfs-k">{d.ficha_practica_k}</p>
        <p class="dfs-practica">{d.ficha_practica}</p>
      </section>

      <section class="dfs-ciclo">
        <h4>{d.ciclo_k}</h4>
        <ol>
          {d.ciclo.map((c: any, i: number) => (
            <li><span class="dfs-n">{i + 1}</span><div><b>{c.quien}</b><p>{c.texto}</p></div></li>
          ))}
        </ol>
        <a class="dfs-boton" href={d.boton_href}>{d.boton} →</a>
      </section>
    </div>
  </div>
  <p class="dfs-nota-pie">{d.nota}</p>
</div>

<style>
  .dfs { font-family: var(--font-sans); color: var(--navy); }
  .dfs h4, .dfs-k { margin: 0 0 8px; font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #6b737d; font-weight: 600; }
  .dfs-barra { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--navy-12); border-radius: 4px; overflow: hidden; margin-bottom: 18px; }
  .dfs-barra > div { background: var(--navy); color: #fff; padding: 14px 18px; display: flex; flex-direction: column; gap: 4px; }
  .dfs-barra b { font-size: clamp(1.6rem, 2.4vw, 2.2rem); font-weight: 600; font-variant-numeric: tabular-nums; color: var(--petrol-bright); line-height: 1; }
  .dfs-barra span { font-size: 13px; line-height: 1.35; color: var(--white-85); }

  .dfs-cuerpo { display: grid; grid-template-columns: 1.15fr 1fr; gap: 18px; align-items: start; }
  .dfs-frases { display: flex; flex-direction: column; gap: 10px; }
  .dfs-frase { background: #fff; border-radius: 4px; padding: 12px 16px; box-shadow: 0 1px 0 var(--navy-08); }
  .dfs-frase header { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; margin-bottom: 6px; }
  .dfs-quien { font-weight: 600; }
  .dfs-ver { font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: 10.5px; }
  .cumple .dfs-ver { color: var(--petrol); }
  .falla .dfs-ver { color: var(--ochre-deep); }
  .pierde .dfs-ver { color: #9a4f37; }
  .dfs-texto, .dfs-cliente { margin: 0; font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.3; }
  .dfs-cliente { color: #4a535e; margin-bottom: 4px; }
  .dfs-texto span, .dfs-cliente span { font-family: var(--font-sans); font-size: 11.5px; font-weight: 600; color: #6b737d; }
  .dfs-nota { margin: 6px 0 0; font-size: 12.5px; line-height: 1.4; color: #4a535e; }
  .dfs-res { margin: 8px 0 0; font-size: 12.5px; font-weight: 600; }

  .dfs-lado { display: flex; flex-direction: column; gap: 14px; }

  .dfs-ficha, .dfs-ciclo { background: #fff; border-radius: 4px; padding: 12px 16px; box-shadow: 0 1px 0 var(--navy-08); }
  .dfs-ciclo ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .dfs-ciclo li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; }
  .dfs-n { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--navy); color: #fff; font-size: 12px; font-weight: 700; }
  .dfs-ciclo b { font-size: 12.5px; color: var(--petrol-deep); }
  .dfs-ciclo p { margin: 2px 0 0; font-size: 13px; line-height: 1.4; }
  .dfs-boton { display: inline-block; margin-top: 12px; padding: 9px 14px; background: var(--navy); color: #fff; border-radius: 3px; font-size: 13px; font-weight: 600; text-decoration: none; }
  .dfs-ficha-nota { margin: -4px 0 8px; font-size: 12px; color: #4a535e; }
  .dfs-ficha dl { margin: 0 0 10px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .dfs-ficha dt { font-size: 11px; color: #6b737d; line-height: 1.3; }
  .dfs-ficha dd { margin: 2px 0 0; font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .dfs-ficha ul { margin: 0 0 10px; padding-left: 16px; font-size: 12.5px; line-height: 1.45; }
  .dfs-practica { margin: 0; font-size: 13px; font-weight: 600; color: var(--petrol-deep); }
  .dfs-nota-pie { margin: 12px 0 0; font-size: 12px; color: #6b737d; }

  @media (min-width: 961px) and (max-height: 960px) {
    .dfs-barra { margin-bottom: 12px; }
    .dfs-barra > div { padding: 9px 16px; }
    .dfs-frase, .dfs-ficha, .dfs-ciclo { padding: 10px 14px; }
  }
  @media (max-width: 960px) {
    .dfs-barra, .dfs-cuerpo { grid-template-columns: 1fr; }
    .dfs-ficha dl { grid-template-columns: 1fr 1fr; }
  }
</style>
