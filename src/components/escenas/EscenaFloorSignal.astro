      marcos(gMP, foco.mp, avance);
      marcos(gMH, (foco.mh || []).map(function (c) { return [c[0], c[1] + PICO * 27, c[2], c[3]]; }), avance);

      // Tarjeta de plantilla: entra en su paso y se queda atenuada después.
      gHora.setAttribute('opacity', paso < PASO_HORA ? 0 : paso === PASO_HORA ? clamp(avance * 2, 0, 1).toFixed(2) : 0.45);
      [horaD, horaM].forEach(function (t) {
        t.filas[VALLE][2].setAttribute('opacity', (1 - e.pl).toFixed(2));
        t.filas[PICO][3].setAttribute('opacity', e.pl.toFixed(2));
        t.v.textContent = fmt(e.sinAtender) + '%';
        t.v.setAttribute('fill', e.pl > 0.5 ? PETRO : TINTA);
        t.antes.setAttribute('opacity', e.pl > 0.5 ? 1 : 0);
      });

      filasP.forEach(function (f, i) {
        f.g.setAttribute('opacity', w >= REVELA[i] ? 1 : 0);
        f.tr.textContent = fmt(es.s[i] * 100) + '%';
        f.co.textContent = fmt(es.c[i] * 100) + ' de 100';
      });
      leyenda.forEach(function (g, i) { g.setAttribute('opacity', w >= REVELA[i] ? 1 : 0); });
      filasD.forEach(function (f, i) {
        f.g.setAttribute('opacity', w >= 1.6 + i * 0.25 ? 1 : 0);
        f.uso.textContent = fmt(es.uso[i]) + '%';
        if (f.tacha) {
          f.tacha.setAttribute('x2', 48 + 222 * e.tr);
          estilo(f.tx, e.tr > 0.95 ? 't-gris t13 w5' : 't-tinta t13 w5');
        }
      });
      filasN.forEach(function (f, i) { f.g.setAttribute('opacity', w >= 2.7 + i * 0.3 ? 1 : 0); f.v.textContent = fmt(es.piden[i]); });
      pasanT.setAttribute('opacity', w >= 2.6 ? 1 : 0);
      pasanT.textContent = 'Pasan frente: ' + fmt(Math.round(es.pasan / 10) * 10) + ' · entran: ' + fmt(Math.round(es.entran));
      for (var a = 0; a < apTinta.length; a++) apTinta[a].setAttribute('opacity', (0.6 * e.ap).toFixed(2));
      apTxt.setAttribute('opacity', e.ap > 0.2 ? 1 : 0);

      // Mapa de calor: aparece con Floor Signal y crece con las semanas y los cambios.
      MANCHAS.forEach(function (m) {
        if (!on || w < REVELA[m.p]) { m.el.setAttribute('opacity', 0); return; }
        var base = rampa(w, REVELA[m.p], REVELA[m.p] + 1.2) * (0.5 + 1.6 * e.s[m.p]);
        if (m.p === 2) base *= 1 + 0.5 * e.ap;
        if (m.surtido) base = e.su;
        m.el.setAttribute('opacity', clamp(base, 0, 0.7).toFixed(2));
        m.el.setAttribute('r', (m.r * (0.8 + 0.2 * rampa(w, 1, 12))).toFixed(1));
      });

      // Gente: no existe antes de Floor Signal; después, por perfil.
      var iIn = 0, iQ = 0;
      if (on) for (var n = 0; n < adentro.length && iIn < poolIn.length; n++) {
        var ag = adentro[n], f0 = (w - ag.t0) / ag.dur;
        if (f0 < 0 || f0 > 1) continue;
        var pos = posicion(ag, f0), c = poolIn[iIn++];
        c.setAttribute('cx', pos[0].toFixed(1)); c.setAttribute('cy', pos[1].toFixed(1));
        c.setAttribute('fill', colorDe(ag.p, w)); c.setAttribute('opacity', 0.95);
        var aro = ag.compra && pos[2] >= 5;
        c.setAttribute('stroke', aro ? TINTA : 'none'); c.setAttribute('stroke-width', aro ? 2.4 : 0);
        if (w >= 2.7 && ag.pide && pos[2] === 4 && iQ < poolQ.length) {
          poolQ[iQ].setAttribute('transform', 'translate(' + pos[0].toFixed(1) + ' ' + pos[1].toFixed(1) + ')');
          poolQ[iQ++].setAttribute('opacity', 1);
        }
      }
      for (; iIn < poolIn.length; iIn++) poolIn[iIn].setAttribute('opacity', 0);
      for (; iQ < poolQ.length; iQ++) poolQ[iQ].setAttribute('opacity', 0);
      var iO = 0;
      if (on) for (var m2 = 0; m2 < afuera.length && iO < poolOut.length; m2++) {
        var pa = afuera[m2], f1 = (w - pa.t0) / pa.dur;
        if (f1 < 0 || f1 > 1) continue;
        var co = poolOut[iO++];
        co.setAttribute('cx', (pa.izq ? lerp(-20, 783, f1) : lerp(783, -20, f1)).toFixed(1));
        co.setAttribute('cy', pa.y.toFixed(1));
        co.setAttribute('fill', colorDe(pa.p, w)); co.setAttribute('opacity', 0.55);
      }
      for (; iO < poolOut.length; iO++) poolOut[iO].setAttribute('opacity', 0);

      if (mTab) {
        mTab.setAttribute('viewBox', '882 ' + (138 + FRANJA[paso]) + ' 446 130');
        // En un <svg> `hidden` solo funciona como atributo.
        mTab.toggleAttribute('hidden', paso === PASO_HORA);
        mHora.toggleAttribute('hidden', paso !== PASO_HORA);
      }
    }

    // ---------------------------------------------------------- scroll
    var topFijo = 72;
    function medir() {
      var vh = window.innerHeight, h = fijo.offsetHeight;
      topFijo = window.innerWidth <= 900 ? 76 : Math.max(72, (vh - h) / 2 + 30);
      fijo.style.top = topFijo + 'px';
      wrap.style.height = reduce ? '' : h + vh * 4.5 + 'px';
    }
    function alScroll() {
      var b = wrap.getBoundingClientRect();
      var recorrido = wrap.offsetHeight - fijo.offsetHeight;
      pintar(reduce || recorrido <= 0 ? 1 : clamp((topFijo - b.top) / recorrido, 0, 1));
    }
    var fija = null;
    try { var v = parseFloat(new URLSearchParams(location.search).get('escena')); if (!isNaN(v)) fija = clamp(v, 0, 1); } catch (er) {}
    medir();
    if (fija !== null) { pintar(fija); return; }
    alScroll();
    window.addEventListener('resize', function () { medir(); ultimo = -1; alScroll(); });
    window.addEventListener('load', function () { medir(); alScroll(); });
    var t = false;
    window.addEventListener('scroll', function () {
      if (t) return;
      t = true;
      requestAnimationFrame(function () { t = false; alScroll(); });
    }, { passive: true });
  })();
</script>
