---
// Escena de Floor Signal amarrada al scroll. Guion de Rodrigo (2026-10-12):
//
//   1. Antes: la tienda en blanco y negro, sin clientes dibujados. Solo un
//      contador en la entrada (cuántos entraron) y otro en la caja (cuánto se
//      vendió).
//   2. Se instala Floor Signal: un lente se abre sobre la tienda y la vuelve a
//      color. Los clientes toman el color de su perfil, aparece el mapa de calor
//      y el tablero se llena. La escena gana color con las semanas.
//   3. Se ven los que pasan y no entran, y los que piden algo que no hay.
//   4. Cambio de aparador: entran más del perfil al que va dirigido.
//   5. Entrenamiento: los diálogos que venden; sube conversión y complementos.
//   6. Surtido: más conversión, más rotación, menos saldos.
//   7. Plantilla por hora: un asesor pasa de la mañana a la tarde, donde los
//      clientes se iban sin que nadie los atendiera (tarjeta junto al calendario).
//   8. El mercado cambia: abre un competidor y el ajuste vuelve a empezar.
//   Un calendario corre las semanas; los indicadores muestran su cambio.
//
// Cada paso cambia una sola cosa y la señala: lo demás se atenúa y lo que
// cambió queda enmarcado. La frase del paso va en un recuadro navy que entra con
// movimiento, para que se note que cambió (feedback de Rodrigo: "no es notorio
// cuando cambia el texto").
//
// Técnica: la mesa con las hojas en blanco es la foto de Codex
// (public/stop-motion/floor-signal/mesa.webp); el plano, los clientes, el mapa
// de calor, el tablero y el calendario se dibujan encima en SVG con mezcla
// multiplicar, como tinta impresa. Todo lo legible es texto real. Coordenadas =
// píxeles de la foto de 1600 x 900. El dibujo vive una vez en <defs> y las
// vistas lo usan con <use>: el CSS de la página no llega a esos clones, por eso
// los estilos de la tinta son atributos de presentación.
//
// Cifras: la conversión total es el promedio de la conversión de cada perfil
// ponderado por su peso en el tráfico, así que el tablero no se contradice.

export interface EscenaTiendaContenido {
  pasos: string[];
  paso_label: string;
  nota: string;
  alt: string;
  semana_label: string;
  perfiles: string[];
}

interface Props {
  contenido: EscenaTiendaContenido;
}
const { contenido: e } = Astro.props;
const total = e.pasos.length;
const MESA = '/stop-motion/floor-signal/mesa.webp';
---

<section class="esc-fs" data-esc-fs>
  <div class="esc-fs-wrap" data-wrap>
    <div class="esc-fs-fijo" data-fijo>
      <div class="esc-fs-guia" data-guia>
        <p class="esc-fs-nota">{e.nota}</p>
        <ol class="esc-fs-pasos">
          {
            e.pasos.map((t, i) => (
              <li data-paso={i} class={i === 0 ? 'is-on' : ''}>
                <span>{e.paso_label.replace('{n}', String(i + 1)).replace('{t}', String(total))}</span>
                {t}
              </li>
            ))
          }
        </ol>
        <p class="esc-fs-avance" aria-hidden="true">{e.pasos.map((_, i) => <i data-tick={i}></i>)}</p>
      </div>

      <!-- Escritorio: la mesa completa, en gris debajo y a color dentro del lente -->
      <div class="esc-fs-escena" data-escena>
        <svg class="esc-fs-mesa capa-gris" viewBox="60 54 1485 756" role="img" aria-label={e.alt}>
          <image href={MESA} x="0" y="0" width="1600" height="900" />
          <use href="#fs-plano" class="tinta" /><use href="#fs-tablero" class="tinta" /><use href="#fs-cal" class="tinta" /><use href="#fs-hora" />
        </svg>
        <svg class="esc-fs-mesa capa-color" viewBox="60 54 1485 756" aria-hidden="true" data-capa-color>
          <image href={MESA} x="0" y="0" width="1600" height="900" />
          <use href="#fs-plano" class="tinta" /><use href="#fs-tablero" class="tinta" /><use href="#fs-cal" class="tinta" /><use href="#fs-hora" />
        </svg>
        <div class="esc-fs-lente" data-lente aria-hidden="true"></div>
      </div>

      <!-- Celular: plano, indicadores y la sección del tablero que cambia -->
      <div class="esc-fs-movil" aria-hidden="true" data-movil>
        <svg viewBox="76 192 763 517"><image href={MESA} x="0" y="0" width="1600" height="900" /><use href="#fs-plano" class="tinta" /></svg>
        <svg viewBox="882 214 446 222"><image href={MESA} x="0" y="0" width="1600" height="900" /><use href="#fs-tablero" class="tinta" /></svg>
        <svg viewBox="882 438 446 130" data-m-tablero><image href={MESA} x="0" y="0" width="1600" height="900" /><use href="#fs-tablero" class="tinta" /></svg>
        <svg viewBox="0 0 446 130" data-m-hora hidden><use href="#fs-hora-m" /></svg>
      </div>
    </div>
  </div>

  <svg class="esc-fs-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <!-- La gente camina hasta la orilla de la hoja y no más allá. -->
      <clipPath id="fs-recorte-plano"><rect x="2" y="2" width="759" height="513" /></clipPath>
      <filter id="fs-sombra" x="-10%" y="-10%" width="130%" height="130%"><feDropShadow dx="2" dy="5" stdDeviation="5" flood-color="#0a1828" flood-opacity="0.28" /></filter>
      <radialGradient id="fs-calor-0"><stop offset="0" stop-color="#4D6A85" stop-opacity="0.9" /><stop offset="1" stop-color="#4D6A85" stop-opacity="0" /></radialGradient>
      <radialGradient id="fs-calor-1"><stop offset="0" stop-color="#B4664B" stop-opacity="0.9" /><stop offset="1" stop-color="#B4664B" stop-opacity="0" /></radialGradient>
      <radialGradient id="fs-calor-2"><stop offset="0" stop-color="#1C5F6B" stop-opacity="0.9" /><stop offset="1" stop-color="#1C5F6B" stop-opacity="0" /></radialGradient>
      <radialGradient id="fs-calor-3"><stop offset="0" stop-color="#A88A3A" stop-opacity="0.9" /><stop offset="1" stop-color="#A88A3A" stop-opacity="0" /></radialGradient>

      <!-- ============ PLANO (hoja izquierda, origen 76,192; 763 x 517) ============ -->
      <g id="fs-plano" transform="translate(76 192)">
        <text x="28" y="30" class="t-gris t15 w5">Tienda Centro · plano de piso</text>
        <g data-leyenda transform="translate(318 25)"></g>
        <text data-z="leyenda-calor" x="735" y="44" text-anchor="end" class="t-gris t11 w6" opacity="0">nube: dónde se junta cada perfil</text>
        <g data-calor></g>
        <g data-z="anaqueles">
          <path d="M330 405 H28 V52 H735 V405 H430" fill="none" stroke="#16202e" stroke-width="3" />
          <g fill="#d7dbe0" stroke="#969ca4" stroke-width="1">
            <rect x="80" y="80" width="600" height="38" />
            <rect x="80" y="148" width="60" height="180" />
            <rect x="232" y="176" width="188" height="48" />
            <rect x="606" y="148" width="74" height="180" />
            <rect x="468" y="346" width="132" height="40" />
          </g>
          <text x="380" y="104" text-anchor="middle" class="t-tinta t14 w6">Línea blanca</text>
          <text transform="translate(115 238) rotate(-90)" text-anchor="middle" class="t-tinta t14 w6">Celulares</text>
          <text x="326" y="205" text-anchor="middle" class="t-tinta t14 w6">Audio</text>
          <text transform="translate(648 238) rotate(-90)" text-anchor="middle" class="t-tinta t14 w6">Pantallas</text>
          <text x="534" y="371" text-anchor="middle" class="t-tinta t14 w6">Caja</text>
        </g>
        <g data-z="surtido" opacity="0">
          <rect x="606" y="148" width="74" height="54" fill="#1C5F6B" fill-opacity="0.22" stroke="#1C5F6B" stroke-width="1.5" />
          <text x="643" y="172" text-anchor="middle" class="t-tinta t13 w7">85"</text>
          <text x="643" y="189" text-anchor="middle" class="t-tinta t10 w6">nuevo</text>
        </g>
        <g data-z="aparador">
          <rect x="120" y="399" width="180" height="12" fill="#fff" stroke="#16202e" stroke-width="1.5" />
          <rect x="460" y="399" width="180" height="12" fill="#fff" stroke="#16202e" stroke-width="1.5" />
          <rect data-aparador-tinta x="121" y="400" width="178" height="10" fill="#1C5F6B" opacity="0" />
          <rect data-aparador-tinta x="461" y="400" width="178" height="10" fill="#1C5F6B" opacity="0" />
          <text data-aparador-txt x="210" y="392" text-anchor="middle" class="t-tinta t13 w7" opacity="0">aparador nuevo</text>
        </g>
        <g data-z="banqueta">
          <line x1="0" y1="430" x2="763" y2="430" stroke="#9aa0a8" stroke-width="1" stroke-dasharray="4 5" />
          <text x="28" y="500" class="t-gris t13 w5">Banqueta</text>
          <text data-pasan x="735" y="500" text-anchor="end" class="t-tinta t14 w7" opacity="0"></text>
        </g>
        <g data-z="leyenda2" opacity="0">
          <circle cx="140" cy="496" r="5.5" fill="#8b9199" stroke="#16202e" stroke-width="2.4" />
          <text x="151" y="500" class="t-gris t12 w5">compró</text>
          <rect x="206" y="488" width="15" height="15" rx="3" fill="#fff" stroke="#16202e" stroke-width="1.2" />
          <text x="213.5" y="500" text-anchor="middle" class="t-tinta t11 w7">?</text>
          <text x="227" y="500" class="t-gris t12 w5">pide algo que no hay</text>
        </g>
        <text data-z="competidor" x="735" y="424" text-anchor="end" class="t-tinta t14 w7" opacity="0">↑ abrió un competidor enfrente</text>
        <g data-z="gente" clip-path="url(#fs-recorte-plano)"><g data-gente></g><g data-preguntas></g></g>
        <!-- contadores: lo único que se sabe antes de Floor Signal -->
        <g data-z="contadores">
          <rect x="172" y="330" width="138" height="52" rx="4" fill="#fff" stroke="#16202e" stroke-width="1.6" />
          <text x="184" y="350" class="t-gris t12 w6 caps">ENTRARON</text>
          <text data-cnt-entran x="184" y="374" class="t-tinta t20 w7">0</text>
          <rect x="468" y="284" width="132" height="52" rx="4" fill="#fff" stroke="#16202e" stroke-width="1.6" />
          <text x="480" y="304" class="t-gris t12 w6 caps">VENTAS</text>
          <text data-cnt-ventas x="480" y="328" class="t-tinta t20 w7">0</text>
        </g>
        <g data-marcos-plano></g>
      </g>

      <!-- ============ TABLERO (hoja derecha, origen 882,138; 446 x 618) ============ -->
      <g id="fs-tablero" transform="translate(882 138)">
        <text x="32" y="34" class="t-gris t11 w6 caps">FLOOR SIGNAL</text>
        <text x="32" y="58" class="t-tinta t20 w6">Tienda Centro</text>
        <text data-semana-t x="414" y="58" text-anchor="end" class="t-gris t14 w5"></text>
        <line x1="32" y1="72" x2="414" y2="72" stroke="#c4c9cf" />
        <text x="274" y="88" class="t-gris t10 w6 caps">VS. SEMANA 0</text>
        <g data-kpis></g>

        <g data-b="perfiles">
          <text x="32" y="322" class="t-gris t11 w6 caps">POR PERFIL</text>
          <text x="330" y="322" text-anchor="end" class="t-gris t11 w6 caps">TRÁFICO</text>
          <text x="414" y="322" text-anchor="end" class="t-gris t11 w6 caps">COMPRA</text>
          <g data-perfiles></g>
        </g>
        <g data-b="dialogos">
          <text x="32" y="436" class="t-gris t11 w6 caps">LO QUE DICE EL ASESOR</text>
          <text x="340" y="436" text-anchor="end" class="t-gris t11 w6 caps">VENDE</text>
          <text x="414" y="436" text-anchor="end" class="t-gris t11 w6 caps">LO USAN</text>
          <g data-dialogos></g>
        </g>
        <g data-b="piden">
          <text x="32" y="548" class="t-gris t11 w6 caps">PIDEN Y NO HAY</text>
          <text x="414" y="548" text-anchor="end" class="t-gris t11 w6 caps">POR SEMANA</text>
          <g data-piden></g>
        </g>
        <g data-marcos-tablero></g>
      </g>

      <!-- ============ PLANTILLA POR HORA (tarjeta bajo el calendario, origen 1374,236) ============ -->
      <g id="fs-hora" transform="translate(1372 234) rotate(1.2)" opacity="0">
        <rect x="0" y="0" width="166" height="324" rx="3" fill="#fbfaf7" filter="url(#fs-sombra)" />
        <g data-hora></g>
        <g data-marcos-hora></g>
      </g>
      <!-- La misma tarjeta, apaisada, para el celular -->
      <g id="fs-hora-m">
        <rect x="0" y="0" width="446" height="130" fill="#fbfaf7" />
        <g data-hora-m></g>
      </g>

      <!-- ============ CALENDARIO (sobre el bloc de notas, origen 1380,82) ============ -->
      <g id="fs-cal" transform="translate(1380 82)">
        <text x="76" y="44" text-anchor="middle" class="t-gris t13 w6 caps">{e.semana_label.toUpperCase()}</text>
        <text data-cal x="76" y="112" text-anchor="middle" class="t-tinta t56 w6">0</text>
      </g>
    </defs>
  </svg>
  <script type="application/json" data-perfiles-nombres set:html={JSON.stringify(e.perfiles).replace(/</g, '\\u003c')}></script>
</section>

<style is:inline>
  .esc-fs { background: var(--paper-warm); border-bottom: 1px solid var(--navy-12); padding: clamp(40px, 4vw, 70px) 0; }
  .esc-fs-wrap { position: relative; }
  .esc-fs-fijo { position: sticky; top: 72px; width: min(100% - 32px, 1440px); margin: 0 auto; container-type: inline-size; }
  .esc-fs-escena { position: relative; border-radius: 4px; overflow: hidden; background: #b9bcc0; }
  .esc-fs-mesa { display: block; width: 100%; height: auto; }
  .esc-fs .capa-gris { filter: grayscale(1) contrast(1.05); }
  .esc-fs .capa-color { position: absolute; inset: 0; clip-path: circle(0 at 27% 52%); }
  .esc-fs-lente {
    position: absolute;
    left: 27%;
    top: 52%;
    width: 0;
    height: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    border: 3px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 0 1px rgba(10, 24, 40, 0.35), 0 0 40px 8px rgba(255, 255, 255, 0.45), inset 0 0 30px rgba(255, 255, 255, 0.35);
    opacity: 0;
    pointer-events: none;
  }
  .esc-fs-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .esc-fs .tinta { mix-blend-mode: multiply; }
  .esc-fs-movil { display: none; }

  /* La frase del paso: recuadro navy sobre la mesa, arriba a la izquierda. */
  .esc-fs-guia {
    position: absolute;
    left: 1.1%;
    top: 1.4%;
    width: 52%;
    z-index: 3;
    pointer-events: none;
    background: var(--navy);
    color: #fff;
    /* Todo en unidades del ancho de la escena: el recuadro escala con la mesa y
       nunca pasa del hueco que hay sobre el plano (~9% del ancho). */
    padding: 0.75cqw 1.2cqw;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(6, 16, 28, 0.25);
  }
  .esc-fs-guia.cambia { animation: fs-cambia 0.6s var(--ease-io, ease) both; }
  @keyframes fs-cambia {
    0% { transform: translateX(-14px); box-shadow: 0 0 0 0 rgba(82, 160, 172, 0.9); }
    60% { box-shadow: 0 0 0 10px rgba(82, 160, 172, 0); }
    100% { transform: none; box-shadow: 0 10px 30px rgba(6, 16, 28, 0.25); }
  }
  .esc-fs-nota { margin: 0 0 0.3cqw; font-size: max(10px, 0.9cqw); font-weight: 500; color: #fff; opacity: 0.85; }
  .esc-fs-avance { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.3cqw; margin: 0.5cqw 0 0; }
  .esc-fs-avance i { height: max(2px, 0.2cqw); background: rgba(255, 255, 255, 0.18); transition: background 0.3s; }
  .esc-fs-avance i.is-on { background: #fff; }
  .esc-fs-pasos { list-style: none; margin: 0; padding: 0; display: grid; }
  .esc-fs-pasos li {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-serif);
    font-size: 1.5cqw;
    font-weight: 500;
    line-height: 1.16;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s, transform 0.35s;
  }
  .esc-fs-pasos li span {
    font-family: var(--font-sans);
    font-size: max(8.5px, 0.72cqw);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--petrol-bright);
  }
  .esc-fs-pasos li.is-on { opacity: 1; transform: none; }
  .esc-fs text { font-family: var(--font-sans); }

  @media (max-width: 900px) {
    .esc-fs-fijo { top: 76px; }
    .esc-fs-escena { display: none; }
    .esc-fs-movil { display: flex; flex-direction: column; gap: 6px; }
    .esc-fs-movil svg { display: block; width: 100%; height: auto; border-radius: 3px; box-shadow: 0 6px 18px rgba(6, 16, 28, 0.12); }
    .esc-fs-movil svg[hidden] { display: none; }
    .esc-fs-guia { position: static; width: auto; margin-bottom: 8px; padding: 10px 14px; }
    .esc-fs-pasos li { font-size: 1.04rem; min-height: 5em; }
    .esc-fs-pasos li span { font-size: 10px; }
    .esc-fs-nota { font-size: 11px; margin-bottom: 4px; }
    .esc-fs-avance { gap: 4px; margin-top: 8px; }
    .esc-fs-avance i { height: 3px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .esc-fs-pasos li { transition: none; transform: none; }
    .esc-fs-guia.cambia { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var sec = document.querySelector('[data-esc-fs]');
    if (!sec) return;
    var NS = 'http://www.w3.org/2000/svg';
    var wrap = sec.querySelector('[data-wrap]');
    var fijo = sec.querySelector('[data-fijo]');
    var guia = sec.querySelector('[data-guia]');
    var pasos = [].slice.call(sec.querySelectorAll('[data-paso]'));
    var ticks = [].slice.call(sec.querySelectorAll('[data-tick]'));
    var q = function (s) { return sec.querySelector(s); };
    var NOMBRES = JSON.parse(q('[data-perfiles-nombres]').textContent);
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------------------------------------------------------- tiempo
    var COLOR = ['#4D6A85', '#B4664B', '#1C5F6B', '#A88A3A', '#7B5E86'];
    var GRIS = '#8b9199', TINTA = '#16202e', PETRO = '#1C5F6B';
    var REVELA = [1.15, 1.15, 2.2, 3.2, 15.6]; // el quinto perfil aparece cuando cambia el mercado
    // Posición en el scroll (P) y semana (S) de cada paso.
    var P = [0, 0.11, 0.23, 0.34, 0.45, 0.57, 0.69, 0.81, 0.96, 1];
    var S = [0, 1, 2.6, 4, 6, 9, 12, 14, 18, 18];
    var CORTES = [0.11, 0.23, 0.34, 0.45, 0.57, 0.69, 0.81];
    var LENTE = [0.11, 0.17]; // tramo del scroll en que se abre el lente
    var FRANJA = [300, 300, 530, 300, 420, 530, 0, 300];
    var PASO_HORA = 6; // paso de la plantilla por hora

    function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
    function rampa(t, a, b) { return clamp((t - a) / (b - a), 0, 1); }
    function lerp(a, b, f) { return a + (b - a) * f; }
    function suave(f) { return f * f * (3 - 2 * f); }
    function semanaDe(p) {
      for (var i = 1; i < P.length; i++) if (p <= P[i]) return lerp(S[i - 1], S[i], (p - P[i - 1]) / (P[i] - P[i - 1]));
      return 12;
    }

    // ---------------------------------------------------------- modelo
    var BASE_S = [0.34, 0.29, 0.22, 0.15], APAR_S = [0.32, 0.27, 0.28, 0.13];
    var BASE_C = [0.13, 0.062, 0.14, 0.18], TREN_C = [0.135, 0.09, 0.148, 0.185], SURT_C = [0.14, 0.10, 0.155, 0.19];
    function estado(w) {
      var ap = rampa(w, 4.0, 5.0), tr = rampa(w, 6.0, 7.6), su = rampa(w, 9.0, 10.6), pl = rampa(w, 12.7, 13.7);
      // Semana 16: abre un competidor enfrente. Aparece un perfil nuevo y baja la
      // entrada; Floor Signal lo marca y el ajuste vuelve a empezar (rec).
      var ev = rampa(w, 15.5, 16.3), rec = rampa(w, 16.8, 18);
      var s = BASE_S.map(function (v, i) { return lerp(v, APAR_S[i], ap) * (1 - 0.12 * ev); });
      s.push(0.12 * ev);
      // Con un asesor más de 6 a 8 de la noche se atiende a los que antes se iban.
      var c = BASE_C.map(function (v, i) { return lerp(lerp(v, TREN_C[i], tr), SURT_C[i], su) * (1 + 0.10 * pl); });
      c.push(lerp(0.07, 0.11, rec));
      var conv = 0;
      for (var i = 0; i < 5; i++) conv += s[i] * c[i];
      var entran = 1000 + 60 * ap - 50 * ev + 30 * rec;
      return {
        ap: ap, tr: tr, su: su, pl: pl, ev: ev,
        sinAtender: lerp(31, 12, pl), s: s, c: c, conv: conv,
        pasan: 6400 * (1 + 0.01 * Math.sin(w * 1.3)),
        entran: entran, compran: entran * conv,
        attach: 18 + 4 * tr + 1 * su,
        rotacion: 6.1 + 0.6 * su,
        saldos: 9 - 2 * su,
        piden: [34 - 24 * su, 21 - 15 * su],
        uso: [lerp(22, 45, tr), lerp(18, 36, tr), lerp(41, 20, tr), lerp(35, 16, tr)]
      };
    }
    var E0 = estado(0);

    // ---------------------------------------------------------- utilidades SVG
    var TONO = { 't-tinta': TINTA, 't-gris': '#6b737d' };
