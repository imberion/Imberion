---
// La columna del home (spec §8.1): un solo campo de partículas, ligado al
// progreso de scroll de este bloque, que recorre ruido -> señal -> resultado.
// Absorbe el canvas que antes vivía suelto en el hero: no conviven dos.
// El hero entra por <slot /> y es la primera etapa (ruido); las otras dos
// etapas viven aquí. El lienzo es sticky y el contenido pasa por encima.
interface Props {
  etiquetas: string[];
  senal: { h: string; p: string };
  resultado: { h: string; p: string };
}
const { etiquetas, senal, resultado } = Astro.props;
---

<div class="columna" data-columna>
  <div class="columna-lienzo">
    <canvas class="columna-canvas" data-columna-canvas aria-hidden="true"></canvas>
  </div>
  <div class="columna-rail-capa">
    <ol class="columna-rail" data-columna-rail>
      {etiquetas.map((e, i) => (
        <li class="columna-rail-item" data-fase={i}>
          <span class="columna-rail-num">{`0${i + 1}`}</span>
          <span class="columna-rail-txt">{e}</span>
        </li>
      ))}
    </ol>
  </div>

  <slot />

  <section class="col-etapa" id="etapa-senal" data-etapa="senal">
    <div class="container">
      <div class="col-etapa-txt">
        <h2>{senal.h}</h2>
        <p class="lead">{senal.p}</p>
      </div>
    </div>
  </section>

  <section class="col-etapa" id="etapa-resultado" data-etapa="resultado">
    <div class="container">
      <div class="col-etapa-txt">
        <h2>{resultado.h}</h2>
        <p class="lead">{resultado.p}</p>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  /* Columna del home. Canvas 2D sin dependencias, técnica del snippet de marca
     anim_noise_to_signal.html, con dos cambios: la dirección es de afuera hacia
     adentro (el ruido nace en los bordes del viewport) y la convergencia cuelga
     del scroll, no de un ciclo de tiempo.

     Fases por progreso p del bloque (0 = arriba del hero, 1 = fin de la 3a etapa):
       p 0.00-0.22  ruido      partículas dispersas en los bordes
       p 0.22-0.52  convergen  de afuera hacia adentro
       p 0.52-0.62  señal      senoidal sostenida
       p 0.62-0.90  resuelven  la senoidal se vuelve curva con punto de decisión

     El petróleo (§8.6) entra SOLO aquí y solo en la ventana de transformación:
     sube con la convergencia, se sostiene mientras hay señal y se apaga al
     resolverse en resultado. petro = conv * (1 - res). En ningún otro elemento. */
  (function () {
    var raiz = document.querySelector('[data-columna]');
    if (!raiz) return;
    var canvas = raiz.querySelector('[data-columna-canvas]');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var items = raiz.querySelectorAll('.columna-rail-item');
    var estatico = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var W = 0, H = 0, cx = 0, cy = 0, ancho = 0, alto = 0, amp = 0;
    var pts = [], progreso = 0, cuadro = 0, corriendo = false, faseVista = -1;

    var BLANCO = [255, 255, 255];
    var PAPEL = [237, 234, 228];       /* --paper  */
    var PETROLEO = [82, 160, 172];     /* --petrol-bright */

    function clamp01(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
    function ease(t) { return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t; }
    function mezcla(a, b, t) {
      return [
        Math.round(a[0] + (b[0] - a[0]) * t),
        Math.round(a[1] + (b[1] - a[1]) * t),
        Math.round(a[2] + (b[2] - a[2]) * t),
      ];
    }
    function rgba(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a.toFixed(3) + ')'; }

    /* Señal: un ciclo de senoidal centrado en el eje de la columna. */
    function senalX(u) { return cx - ancho / 2 + u * ancho; }
    function senalY(u) { return cy + Math.sin(u * Math.PI * 2) * amp; }
    /* Resultado: la misma onda, ahora montada sobre una tendencia que sube.
       Es la lectura concreta, no una ilustración: curva + punto de decisión. */
    function resX(u) { return cx - ancho / 2 + u * ancho; }
    function resY(u) {
      var e = u * u * (3 - 2 * u);
      return cy + alto * (0.46 - e) + Math.sin(u * Math.PI * 2) * alto * 0.055;
    }
    var U_DECISION = 0.74;

    function geometria() {
      var angosto = W < 760;
      cx = W >= 1024 ? W * 0.615 : W * 0.5;
      /* En pantalla angosta el texto ocupa el ancho completo y va centrado:
         la figura baja para no quedar encima de la lectura. */
      cy = angosto ? H * 0.78 : H * 0.5;
      ancho = angosto ? W * 0.74 : Math.min(W * 0.54, 1000);
      /* La amplitud cuelga del ancho, no del alto del viewport: atada al alto,
         en 390px la senoidal se cerraba en un rizo en vez de leerse como onda. */
      amp = Math.min(ancho * 0.095, 88);
      alto = Math.min(ancho * 0.34, 300);
    }

    function sembrar() {
      var n = W < 760 ? 200 : 520;
      pts = [];
      for (var i = 0; i < n; i++) {
        var u = n === 1 ? 0.5 : i / (n - 1);
        /* Ruido: proyectado sobre el borde del viewport desde el centro, con
           dispersión hacia afuera y hacia adentro de esa orilla. */
        var a = Math.random() * Math.PI * 2;
        var ca = Math.cos(a), sa = Math.sin(a);
        var k = Math.min(
          Math.abs((W * 0.5) / (Math.abs(ca) < 0.001 ? 0.001 : ca)),
          Math.abs((H * 0.5) / (Math.abs(sa) < 0.001 ? 0.001 : sa))
        );
        /* Anillo pegado a la orilla: el tercio central queda limpio para que
           el texto del hero se lea sin moteado encima. Un poco más allá de 1.0
           es deliberado, unas cuantas partículas nacen fuera de cuadro. */
        var d = k * (0.76 + Math.random() * 0.32);
        pts.push({
          nx: W * 0.5 + ca * d,
          ny: H * 0.5 + sa * d,
          sx: senalX(u), sy: senalY(u),
          rx: resX(u), ry: resY(u),
          ph: Math.random() * 6.283,
          r: Math.random() * 1.3 + 0.55,
          al: Math.random() * 0.42 + 0.34,
        });
      }
    }

    /* Gancho de QA visual: ?columna=0.45 congela el progreso en ese valor para
       poder capturar cualquier punto del arco en headless, donde no hay scroll.
       Sin el parámetro no cambia nada. */
    var forzado = null;
    var mQA = /[?&]columna=([01](?:\.\d+)?)/.exec(window.location.search);
    if (mQA) forzado = parseFloat(mQA[1]);

    function medir() {
      if (forzado !== null) { progreso = forzado; return; }
      var r = raiz.getBoundingClientRect();
      var total = r.height - window.innerHeight;
      progreso = total <= 0 ? 1 : clamp01(-r.top / total);
    }

    function rail(fase) {
      if (fase === faseVista) return;
      faseVista = fase;
      for (var i = 0; i < items.length; i++) {
        items[i].classList.toggle('on', i === fase);
        items[i].classList.toggle('pasada', i < fase);
      }
    }

    function dibujar() {
      var conv = estatico ? 1 : ease(clamp01((progreso - 0.22) / 0.3));
      var res = estatico ? 1 : ease(clamp01((progreso - 0.62) / 0.28));
      var petro = conv * (1 - res);
      rail(res > 0.5 ? 2 : conv > 0.45 ? 1 : 0);

      var base = mezcla(BLANCO, PAPEL, res);
      var color = mezcla(base, PETROLEO, petro);
      var t = cuadro * 0.008;
      var ampRuido = 26 * (1 - conv);
      var ampSenal = 4.2 * conv * (1 - res);

      ctx.clearRect(0, 0, W, H);

      for (var i = 0; i < pts.length; i++) {
        var p = pts[i];
        var bx = p.nx + (p.sx - p.nx) * conv;
        var by = p.ny + (p.sy - p.ny) * conv;
        var x = bx + (p.rx - bx) * res;
        var y = by + (p.ry - by) * res;
        if (!estatico) {
          var a1 = ampRuido + ampSenal;
          x += Math.sin(t * 0.62 + p.ph) * a1 + Math.sin(t * 0.27 + p.ph * 0.7) * a1 * 0.42;
          y += Math.cos(t * 0.78 + p.ph * 1.15) * a1 * 0.72 + Math.cos(t * 0.33 + p.ph) * a1 * 0.3;
        }
        ctx.beginPath();
        ctx.arc(x, y, p.r * (1.55 - conv * 0.5 - res * 0.12), 0, 6.283);
        ctx.fillStyle = rgba(color, p.al * (0.92 - conv * 0.12) * (1 + petro * 0.22));
        ctx.fill();
      }

      /* Traza de la señal: aparece cuando ya convergió y se apaga al resolverse. */
      var aSenal = clamp01((conv - 0.5) / 0.3) * 0.4 * (1 - res);
      if (aSenal > 0.004) {
        ctx.beginPath();
        for (var s = 0; s <= 80; s++) {
          var us = s / 80;
          if (s === 0) ctx.moveTo(senalX(us), senalY(us));
          else ctx.lineTo(senalX(us), senalY(us));
        }
        ctx.strokeStyle = rgba(color, aSenal);
        ctx.lineWidth = 1.2;
        ctx.stroke();
      }

      /* Resultado: la curva se traza sola conforme se resuelve. */
      if (res > 0.02) {
        var hasta = Math.min(1, res * 1.18);
        ctx.beginPath();
        for (var q = 0; q <= 90; q++) {
          var uq = (q / 90) * hasta;
          if (q === 0) ctx.moveTo(resX(uq), resY(uq));
          else ctx.lineTo(resX(uq), resY(uq));
        }
        ctx.strokeStyle = rgba(base, res * 0.62);
        ctx.lineWidth = 1.5;
        ctx.stroke();

        if (hasta >= U_DECISION) {
          var aD = clamp01((hasta - U_DECISION) / 0.18);
          var dx = resX(U_DECISION), dy = resY(U_DECISION);
          var piso = cy + alto * 0.56;
          ctx.beginPath();
          ctx.moveTo(dx, dy);
          ctx.lineTo(dx, piso);
          /* Marca de piso: sin ella la plomada del punto de decisión se queda
             colgando en el aire y deja de leerse como lectura sobre un eje. */
          ctx.moveTo(dx - 13, piso);
          ctx.lineTo(dx + 13, piso);
          ctx.strokeStyle = rgba(base, aD * 0.3);
          ctx.lineWidth = 1;
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(dx, dy, 3.6, 0, 6.283);
          ctx.fillStyle = rgba(base, aD * 0.95);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(dx, dy, 9.5, 0, 6.283);
          ctx.strokeStyle = rgba(base, aD * 0.28);
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }
    }

    function dimensionar() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth || window.innerWidth;
      H = canvas.clientHeight || window.innerHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      geometria();
      sembrar();
      if (!estatico) medir();
      dibujar();
    }

    function bucle() {
      if (!corriendo) return;
      cuadro++;
      medir();
      dibujar();
      requestAnimationFrame(bucle);
    }

    dimensionar();

    var reajuste;
    window.addEventListener('resize', function () {
      clearTimeout(reajuste);
      reajuste = setTimeout(dimensionar, 160);
    });

    if (estatico) return;

    /* El bucle solo corre mientras la columna está en pantalla. */
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entradas) {
        var dentro = entradas[0].isIntersecting;
        if (dentro && !corriendo) { corriendo = true; requestAnimationFrame(bucle); }
        else if (!dentro) { corriendo = false; }
      }, { rootMargin: '80px' }).observe(raiz);
    } else {
      corriendo = true;
      requestAnimationFrame(bucle);
    }
  })();
</script>
