---
// Ficha de una herramienta del catálogo. Las tres rutas por locale sólo pasan
// slug y locale; el cuerpo entero vive aquí.
import type { Locale } from '../i18n/index';
import Base from '../layouts/Base.astro';
import { ZCAL_30MIN } from '../lib/enlaces';
import { contenidoFicha, enlazarFichas } from '../lib/catalogo';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const c = contenidoFicha(slug, locale);
const relacion = enlazarFichas(c.relacion_p, locale, slug);
---

<Base title={c.__title} description={c.hero_lead} locale={locale} rutaEs={`catalogo/${slug}`}>
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="page-hero-content">
      <div class="eyebrow">{c.familia_label}</div>
      <h1 set:html={c.hero_h1} />
      <p class="lead" set:html={c.hero_lead} />
    </div>
  </section>

  <section class="bloque">
    <div class="container">
      <div class="sec-head">
        <span class="sec-num">01</span>
      </div>
      <h2 set:html={c.que_hace_h2} />
      <p class="cuerpo" set:html={c.que_hace_p} />

      <div class="rejilla">
        {
          c.que_hace_items.map((item, i) => (
            <div class="item">
              <span class="item-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                {item.titulo && <h3 set:html={item.titulo} />}
                <p set:html={item.texto} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bloque bloque--dark">
    <div class="container">
      <div class="sec-head">
        <span class="sec-num">02</span>
      </div>
      <h2 set:html={c.valor_h2} />
      <p class="cuerpo" set:html={c.valor_p} />
      <p class="sowhat" set:html={c.sowhat} />
    </div>
  </section>

  <section class="bloque">
    <div class="container">
      <div class="sec-head">
        <span class="sec-num">03</span>
      </div>
      <h2 set:html={c.industrias_h2} />
      <ul class="chips">
        {
          c.industrias.map((ind) => (
            <li>
              <a class="tag" href={ind.href}>
                {ind.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bloque bloque--fino">
    <div class="container">
      <div class="sec-head">
        <span class="sec-num">04</span>
      </div>
      <h2 set:html={c.relacion_h2} />
      <p class="cuerpo cuerpo--enlaces" set:html={relacion} />
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <h2 set:html={c.ctastrip_h2} />
      <p set:html={c.ctastrip_p} />
      <a class="btn btn-primary" href={ZCAL_30MIN} target="_blank" rel="noopener">
        {c.ctastrip_btn}
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* site.css pinta .lead en navy-72, que sobre el hero navy queda ilegible.
     Los HTML del sitio viejo lo corregían en su <style> por página; el shell
     de v2 todavía no, así que se corrige aquí. */
  .page-hero .lead {
    color: var(--white-65);
  }

  h2,
  h3 {
    font-family: var(--font-serif);
    line-height: 1.12;
    font-weight: 300;
  }

  .bloque {
    padding: 92px 0;
  }
  .bloque--fino {
    padding: 76px 0;
    border-top: 1px solid var(--navy-12);
  }
  .bloque h2 {
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    max-width: 820px;
  }

  .sec-head {
    margin-bottom: 14px;
  }

  .cuerpo {
    margin-top: 22px;
    max-width: 660px;
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--navy-72);
  }

  /* ---------- qué hace: rejilla de hairlines ---------- */
  .rejilla {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    border-top: 1px solid var(--navy-12);
    border-left: 1px solid var(--navy-12);
    background: var(--white);
  }
  .item {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 28px 28px 26px;
    border-right: 1px solid var(--navy-12);
    border-bottom: 1px solid var(--navy-12);
    background: var(--white);
    transition: background 0.25s var(--ease);
  }
  .item:hover {
    background: var(--paper);
  }
  .item-n {
    /* Cifra suelta: DM Sans, nunca el "1" de Cormorant. */
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gray-blue);
    font-variant-numeric: tabular-nums;
    padding-top: 5px;
  }
  .item h3 {
    font-size: 1.24rem;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 7px;
  }
  .item p {
    font-size: 13.5px;
    line-height: 1.62;
    color: var(--navy-72);
  }

  /* ---------- cómo genera valor ---------- */
  .bloque--dark {
    background: var(--navy);
    color: #fff;
  }
  .bloque--dark h2 {
    color: #fff;
  }
  .bloque--dark .cuerpo {
    color: var(--white-65);
  }
  .bloque--dark .sec-num {
    color: var(--white-45);
  }
  .bloque--dark .sec-num::after {
    background: var(--white-25);
  }

  .sowhat {
    margin-top: 40px;
    padding-left: 26px;
    border-left: 1px solid var(--slate-soft);
    max-width: 700px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    line-height: 1.34;
    letter-spacing: -0.005em;
    color: #fff;
  }

  /* ---------- industrias ---------- */
  .chips {
    margin-top: 34px;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chips .tag {
    display: inline-block;
    padding: 9px 16px;
    border-radius: var(--r);
    font-size: 13px;
    font-weight: 500;
    transition:
      background 0.25s var(--ease),
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .chips .tag:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  /* ---------- relación con otras fichas ---------- */
  .cuerpo--enlaces :global(a) {
    color: var(--navy);
    border-bottom: 1px solid var(--navy-20);
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .cuerpo--enlaces :global(a:hover) {
    border-bottom-color: var(--navy);
  }

  /* ---------- franja de cierre ---------- */
  .cta-strip {
    background: var(--navy-deep);
    padding: 88px 0;
    text-align: center;
  }
  .cta-strip h2 {
    color: #fff;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    margin-bottom: 18px;
  }
  .cta-strip p {
    color: var(--white-65);
    font-size: 15px;
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 30px;
  }

  @media (max-width: 600px) {
    .bloque,
    .bloque--fino {
      padding: 58px 0;
    }
    .rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
