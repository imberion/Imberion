---
// Ficha de una herramienta del catálogo. Las tres rutas por locale sólo pasan
// slug y locale; el cuerpo entero vive aquí.
import type { Locale } from '../i18n/index';
import Base from '../layouts/Base.astro';
import { ZCAL_30MIN } from '../lib/enlaces';
import { contenidoFicha, enlazarFichas } from '../lib/catalogo';
import DemoConcierge from './demos/DemoConcierge.astro';
import DemoMarketSignal from './demos/DemoMarketSignal.astro';
import DemoTrainingSignal from './demos/DemoTrainingSignal.astro';
import DemoVirtualBuyerPersonas from './demos/DemoVirtualBuyerPersonas.astro';

interface Props {
  locale: Locale;
  slug: string;
}

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { locale, slug } = Astro.props;
const c = contenidoFicha(slug, locale);

// ---------------------------------------------------------------- pieza visual
// CP11d: una ficha lleva su pieza visual propia (captura real o pieza del
// material del producto; nunca un gráfico conceptual) cuando existen las dos
// mitades: src/assets/catalogo/<slug>.png y la clave `pieza` en su JSON. Una
// sola de las dos es un error de build, no un hueco silencioso. Ver el README
// de la carpeta para la procedencia de cada archivo.
const PIEZAS = import.meta.glob<ImageMetadata>('../assets/catalogo/*.png', { import: 'default', eager: true });
const piezaImg = PIEZAS[`../assets/catalogo/${slug}.png`];
if (piezaImg && !c.pieza) {
  throw new Error(`catálogo: existe src/assets/catalogo/${slug}.png pero ${slug}.json no trae la clave "pieza".`);
}
if (c.pieza && !piezaImg) {
  throw new Error(`catálogo: ${slug}.json declara "pieza" pero falta src/assets/catalogo/${slug}.png.`);
}
// Las piezas se capturan a 2x: su ancho natural en pantalla es la mitad del
// archivo. Se deja crecer hasta un 15 % más y nunca se estira más allá, para que
// una tarjeta angosta no se infle al ancho del contenedor con el texto gigante.
const pieza = piezaImg && c.pieza
  ? { img: piezaImg, ...c.pieza, maxAncho: Math.round((piezaImg.width / 2) * 1.15) }
  : null;
const relacion = enlazarFichas(c.relacion_p, locale, slug);

// ---------------------------------------------------------------- mini-demo
// Gancho de las mini-demos interactivas (§8.5c/§8.5d del spec, CP10 10d). Una
// ficha lleva demo cuando se cumplen las dos cosas: su JSON de contenido trae
// la clave `demo` (con las cadenas en los tres locales) y su slug está
// registrado abajo con el componente que la pinta. Falta cualquiera de las
// dos y la ficha rinde igual que siempre, sin bloque y sin JS.
//
// Para sumar otra ficha: se escribe su componente en `src/components/demos/`,
// se agrega `slug: Componente` a este mapa y se pone la clave `demo` en su
// JSON. No hay que tocar nada más.
const DEMOS: Record<string, any> = {
  concierge: DemoConcierge,
  'market-signal': DemoMarketSignal,
  'training-signal': DemoTrainingSignal,
  'virtual-buyer-personas': DemoVirtualBuyerPersonas,
};
const contenidoDemo = (c as Record<string, any>).demo;
const Demo = contenidoDemo ? (DEMOS[slug] ?? null) : null;
---

<Base title={c.__title} description={c.hero_lead} locale={locale} rutaEs={`catalogo/${slug}`}>
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="page-hero-content">
      <h1 set:html={c.hero_h1} />
      <p class="lead" set:html={c.hero_lead} />
    </div>
  </section>

  {Demo && <Demo contenido={contenidoDemo} />}

  {
    // Con demo, la demo es la pieza visual de la ficha; la imagen fija sobra.
    pieza && !Demo && (
      <section class="pieza" aria-label={c.nombre}>
        <div class="container">
          <figure class="pieza-fig" style={`max-width:${pieza.maxAncho}px`}>
            <div class="pieza-marco">
              <Image
                src={pieza.img}
                alt={pieza.alt}
                widths={[720, 1200, 1800]}
                sizes="(max-width: 700px) 94vw, min(92vw, 1240px)"
                format="webp"
                quality={82}
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="pieza-pie">{pieza.pie}</figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <section class="bloque">
    <div class="container">
      <h2 set:html={c.que_hace_h2} />
      {c.que_hace_p && <p class="cuerpo" set:html={c.que_hace_p} />}
      {(c as any).film && (
        <figure class="film">
          <video src={(c as any).film.src} poster={(c as any).film.poster} autoplay muted loop playsinline preload="metadata" aria-label={(c as any).film.alt}></video>
        </figure>
      )}

      <div class="rejilla" style={`--n:${c.que_hace_items.length}`}>
        {
          c.que_hace_items.map((item, i) => (
            <div class="item">
              <span class="item-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                {item.titulo && <h3 set:html={item.titulo} />}
                <p set:html={item.texto} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    c.valor_h2 && (
      <section class="bloque bloque--dark">
        <div class="container">
          <h2 set:html={c.valor_h2} />
          <p class="cuerpo" set:html={c.valor_p} />
          <p class="sowhat" set:html={c.sowhat} />
        </div>
      </section>
    )
  }

  <section class="cta-strip">
    <div class="container">
      <h2 set:html={c.ctastrip_h2} />
      <p set:html={c.ctastrip_p} />
      <a class="btn btn-primary" href={ZCAL_30MIN} target="_blank" rel="noopener">
        {c.ctastrip_btn}
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* site.css pinta .lead en navy-72, que sobre el hero navy queda ilegible.
     Los HTML del sitio viejo lo corregían en su <style> por página; el shell
     de v2 todavía no, así que se corrige aquí. */
  .page-hero .lead {
    color: var(--white-65);
  }

  /* ---------- pieza visual ---------- */
  /* La pieza sube sobre el borde inferior del hero navy: la mitad de arriba
     apoya en el navy y la de abajo en el papel, como una captura puesta sobre
     la mesa. El hero lleva overflow hidden, así que el solape va aquí. */
  .pieza {
    position: relative;
    z-index: 1;
    margin-top: -56px;
    padding-bottom: clamp(20px, 2.5vw, 40px);
  }
  .pieza-fig {
    margin: 0; /* el max-width lo pone cada pieza según su ancho natural */
  }
  .pieza-marco {
    background: var(--white);
    border: 1px solid var(--navy-12);
    box-shadow: 0 24px 60px rgba(6, 16, 28, 0.22), 0 2px 6px rgba(6, 16, 28, 0.08);
    overflow: hidden;
  }
  .pieza-marco :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .pieza-pie {
    margin-top: 14px;
    max-width: 78ch;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--navy-60);
  }
  @media (max-width: 700px) {
    .pieza { margin-top: -32px; }
    .pieza-marco { box-shadow: 0 14px 34px rgba(6, 16, 28, 0.2); }
  }

  h2,
  h3 {
    font-family: var(--font-serif);
    line-height: 1.12;
    font-weight: 300;
  }

  .bloque {
    padding: clamp(70px, 6.5vw, 150px) 0;
  }
  .bloque--fino {
    padding: clamp(60px, 5vw, 118px) 0;
    border-top: 1px solid var(--navy-12);
  }
  .bloque h2 {
    font-size: clamp(1.9rem, 3.2vw, 3.4rem);
    max-width: 22ch;
  }

  .film { margin: 36px 0 8px; max-width: 980px; border-radius: 4px; overflow: hidden; background: #E3E4E6; }
  .film video { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: reduce) { .film video { animation: none; } }
  .sec-head {
    margin-bottom: 14px;
  }

  .cuerpo {
    margin-top: 22px;
    max-width: 66ch;
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--navy-72);
  }

  /* ---------- qué hace: rejilla de hairlines ---------- */
  /* Mismo criterio que el índice: nunca más columnas que ítems, y sin fondo
     propio para que la última fila incompleta no deje un hueco blanco. */
  .rejilla {
    margin-top: 44px;
    display: grid;
    width: min(100%, calc(var(--n, 4) * 520px));
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    border-top: 1px solid var(--navy-12);
    border-left: 1px solid var(--navy-12);
  }
  .item {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: clamp(26px, 1.8vw, 38px) clamp(26px, 1.8vw, 34px);
    border-right: 1px solid var(--navy-12);
    border-bottom: 1px solid var(--navy-12);
    background: var(--white);
    transition: background 0.25s var(--ease);
  }
  .item:hover {
    background: var(--paper);
  }
  .item-n {
    /* Cifra suelta: DM Sans, nunca el "1" de Cormorant. */
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gray-blue);
    font-variant-numeric: tabular-nums;
    padding-top: 5px;
  }
  .item h3 {
    font-size: 1.24rem;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 7px;
  }
  .item p {
    font-size: 13.5px;
    line-height: 1.62;
    color: var(--navy-72);
  }

  /* ---------- cómo genera valor ---------- */
  .bloque--dark {
    background: var(--navy);
    color: #fff;
  }
  .bloque--dark h2 {
    color: #fff;
  }
  .bloque--dark .cuerpo {
    color: var(--white-65);
  }
  .bloque--dark .sec-num {
    color: var(--white-45);
  }
  .bloque--dark .sec-num::after {
    background: var(--white-25);
  }

  .sowhat {
    margin-top: 40px;
    padding-left: 26px;
    border-left: 1px solid var(--slate-soft);
    max-width: 26ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.35rem, 2.4vw, 2.4rem);
    line-height: 1.34;
    letter-spacing: -0.005em;
    color: #fff;
  }

  /* ---------- industrias ---------- */
  .chips {
    margin-top: 34px;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chips .tag {
    display: inline-block;
    padding: 9px 16px;
    border-radius: var(--r);
    font-size: 13px;
    font-weight: 500;
    transition:
      background 0.25s var(--ease),
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .chips .tag:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  /* ---------- relación con otras fichas ---------- */
  .cuerpo--enlaces :global(a) {
    color: var(--navy);
    border-bottom: 1px solid var(--navy-20);
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .cuerpo--enlaces :global(a:hover) {
    border-bottom-color: var(--navy);
  }

  /* ---------- franja de cierre ---------- */
  .cta-strip {
    background: var(--navy-deep);
    padding: 88px 0;
    text-align: center;
  }
  .cta-strip h2 {
    color: #fff;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    margin-bottom: 18px;
  }
  .cta-strip p {
    color: var(--white-65);
    font-size: 15px;
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 30px;
  }

  @media (max-width: 600px) {
    .rejilla {
      width: 100%;
      grid-template-columns: 1fr;
    }
  }
</style>
