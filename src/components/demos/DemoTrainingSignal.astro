---
// Mini-demo de Training Signal, con dos modos sobre el mismo producto:
//
// - Ver la respuesta: el cliente suelta una objeción y el panel devuelve lo que
//   respondió el mejor asesor en ese caso (movimiento, frase y por qué funciona).
//   `combos[p][o]` es la combinación del producto p con la objeción o; las nueve
//   ya vienen en el HTML y el navegador solo decide cuál se ve.
// - Practicar con cliente simulado: un cliente con perfil definido
//   (`practica.clientes[p]`) lleva la conversación durante tres turnos. Cada
//   opción trae la reacción del cliente y la retroalimentación; el cierre sale
//   del número de respuestas buenas (3 compra, 2 pide tiempo, 0 o 1 se va). En
//   el producto real la práctica es por voz; aquí se escribe y la interfaz lo
//   dice.
//
// Es determinista igual que Virtual Buyer Personas: todo el diálogo está escrito
// en el JSON de contenido y viaja como JSON en la página. No calcula ni llama a
// nada.
//
// El panel lleva `data-dialogo` porque los globos y las opciones son habla
// citada entre cliente y asesor en una tienda: ahí el trato de usted es del
// personaje, no del sitio.
//
// Color: navy sobre papel. El petróleo aparece solo en la práctica: la
// retroalimentación de una respuesta buena y el cierre cuando el cliente compra.

export interface DemoTrainingSignalContenido {
  eyebrow: string;
  titulo: string;
  intro: string;
  producto_label: string;
  objecion_label: string;
  app: { producto: string; sku_label: string; estado: string };
  productos: Array<{ nombre: string; detalle: string; sku: string; precio: string }>;
  objeciones: Array<{ frase: string }>;
  quien_cliente: string;
  quien_asesor: string;
  modo_ver: string;
  modo_practicar: string;
  movimiento_label: string;
  frase_label: string;
  porque_label: string;
  simulacion: string;
  combos: Array<Array<{ movimiento: string; frase: string; porque: string }>>;
  practica: {
    perfil_label: string;
    quien_cliente: string;
    quien_asesor: string;
    voz_label: string;
    voz_nota: string;
    turno_label: string;
    de: string;
    pregunta: string;
    nota_buena: string;
    nota_mala: string;
    mejor_label: string;
    btn_seguir: string;
    btn_resultado: string;
    btn_otra: string;
    resultado_label: string;
    resultados: { compra: string; duda: string; se_va: string };
    marcador: string;
    clientes: Array<{
      perfil: string;
      rasgos: string[];
      turnos: Array<{
        cliente: string;
        dur: string;
        opciones: Array<{ texto: string; reaccion: string; nota: string; buena: boolean }>;
      }>;
      cierre: { compra: string; duda: string; se_va: string };
    }>;
  };
}

interface Props {
  contenido: DemoTrainingSignalContenido;
}

const { contenido: d } = Astro.props;
const pr = d.practica;
// El diálogo de la práctica viaja como JSON; `<` escapado para que ningún texto
// pueda cerrar la etiqueta <script>.
const practicaJson = JSON.stringify(pr).replace(/</g, '\\u003c');
---

<section class="demo-bloque" id="mini-demo">
  <div class="container">
    <div class="demo-head">
      <div class="eyebrow demo-eyebrow">{d.eyebrow}</div>
      <h2>{d.titulo}</h2>
      <p class="cuerpo">{d.intro}</p>
    </div>

    <div class="ts-wrap" data-demo-ts role="group" aria-label={d.titulo}>
      <div class="ts-ctrl">
        <div class="ts-grupo">
          <span class="ts-k" id="ts-k-prod">{d.producto_label}</span>
          <div class="ts-prods" role="group" aria-labelledby="ts-k-prod">
            {
              d.productos.map((p, i) => (
                <button
                  type="button"
                  class={`ts-prod${i === 0 ? ' on' : ''}`}
                  data-prod-btn={i}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  <span class="ts-scan" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                      <path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16" />
                      <path d="M8 8.5v7M10.5 8.5v7M13 8.5v7M15.5 8.5v7" />
                    </svg>
                  </span>
                  <span class="ts-prod-txt">
                    <span class="ts-prod-n">{p.nombre}</span>
                    <span class="ts-prod-d">{p.detalle}</span>
                  </span>
                  <span class="ts-prod-p">{p.precio}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="ts-grupo ts-objs-grupo">
          <span class="ts-k" id="ts-k-obj">{d.objecion_label}</span>
          <div class="ts-objs" role="group" aria-labelledby="ts-k-obj" data-dialogo>
            {
              d.objeciones.map((o, i) => (
                <button
                  type="button"
                  class={`ts-obj${i === 0 ? ' on' : ''}`}
                  data-obj-btn={i}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  “{o.frase}”
                </button>
              ))
            }
          </div>
        </div>

        <div class="ts-grupo ts-perfiles">
          <span class="ts-k">{pr.perfil_label}</span>
          {
            pr.clientes.map((c, i) => (
              <div class={`ts-perfil${i === 0 ? ' on' : ''}`} data-perfil={i}>
                <span class="ts-perfil-n">{c.perfil}</span>
                <ul>
                  {c.rasgos.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="ts-app" data-dialogo>
        <div class="ts-barra">
          <span class="ts-marca"><span class="ts-marca-o" aria-hidden="true"></span>{d.app.producto}</span>
          <span class="ts-estado"><span class="ts-estado-dot" aria-hidden="true"></span>{d.app.estado}</span>
        </div>

        <div class="ts-modos" role="group">
          <button type="button" class="ts-modo on" data-modo-btn="ver" aria-pressed="true">{d.modo_ver}</button>
          <button type="button" class="ts-modo" data-modo-btn="practicar" aria-pressed="false">{d.modo_practicar}</button>
        </div>

        <div class="ts-panel" aria-live="polite">
          {
            d.combos.map((fila, p) =>
              fila.map((c, o) => (
                <div class={`ts-combo${p === 0 && o === 0 ? ' on' : ''}`} data-p={p} data-o={o}>
                  <div class="ts-sku">
                    <span class="ts-sku-k">{d.app.sku_label}</span>
                    <span class="ts-sku-v">{d.productos[p].sku}</span>
                    <span class="ts-sku-n">{d.productos[p].nombre}</span>
                    <span class="ts-sku-p">{d.productos[p].precio}</span>
                  </div>

                  <div class="ts-bub cli">
                    <span class="who">{d.quien_cliente}</span>
                    {d.objeciones[o].frase}
                  </div>

                  <div class="ts-ver">
                    <div class="ts-mov">
                      <span class="ts-lbl">{d.movimiento_label}</span>
                      <p>{c.movimiento}</p>
                    </div>
                    <div class="ts-bub ase">
                      <span class="who">
                        {d.quien_asesor} · {d.frase_label}
                      </span>
                      {c.frase}
                    </div>
                    <div class="ts-porque">
                      <span class="ts-lbl">{d.porque_label}</span>
                      <p>{c.porque}</p>
                    </div>
                  </div>
                </div>
              ))
            )
          }
        </div>

        <div class="ts-practica" data-practica aria-live="polite">
          <div class="ts-voz">
            <span class="ts-voz-pill">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                <rect x="9" y="3" width="6" height="11" rx="3" />
                <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" />
              </svg>
              {pr.voz_label}
            </span>
            <span class="ts-voz-nota">{pr.voz_nota}</span>
            <span class="ts-turnos" data-turnos aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="ts-hilo" data-hilo></div>
          <div class="ts-turno" data-turno>
            <p class="ts-preg" data-preg></p>
            <div class="ts-opcs" data-opcs></div>
          </div>
          <div class="ts-coach" data-coach hidden>
            <span class="ts-coach-k" data-coach-k></span>
            <p data-coach-nota></p>
            <div class="ts-coach-mejor" data-coach-mejor hidden>
              <span class="ts-lbl">{pr.mejor_label}</span>
              <p data-coach-mejor-t></p>
            </div>
            <button type="button" class="ts-btn" data-seguir></button>
          </div>
          <div class="ts-final" data-final hidden>
            <span class="ts-lbl">{pr.resultado_label}</span>
            <p class="ts-final-r" data-final-r></p>
            <p class="ts-final-m" data-final-m></p>
            <button type="button" class="ts-btn" data-otra>{pr.btn_otra}</button>
          </div>
        </div>
      </div>
    </div>
    <script type="application/json" data-ts-practica set:html={practicaJson}></script>

    <p class="demo-nota">{d.simulacion}</p>
  </div>
</section>

<style is:inline>
  /* Tokens del sitio (site.css / shell.css). Navy sobre papel; el petróleo
     solo marca la respuesta correcta del ensayo. Selectores prefijados por
     `.demo-bloque` porque el <style is:inline> no lleva scope de Astro. */
  .demo-bloque {
    scroll-margin-top: 86px;
    padding: clamp(70px, 6.5vw, 150px) 0;
    background: var(--paper-warm);
    border-top: 1px solid var(--navy-12);
    border-bottom: 1px solid var(--navy-12);
  }
  .demo-bloque .demo-head h2 {
    font-family: var(--font-serif);
    font-weight: 300;
    line-height: 1.12;
    font-size: clamp(1.9rem, 3.2vw, 3.4rem);
    max-width: 22ch;
    margin-top: 12px;
  }
  .demo-bloque .demo-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
  }
  .demo-bloque .demo-head .cuerpo {
    margin-top: 20px;
    max-width: 66ch;
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--navy-72);
  }

  .demo-bloque .ts-wrap {
    margin-top: 46px;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: start;
  }

  /* ---------- controles ---------- */
  .demo-bloque .ts-ctrl {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }
  .demo-bloque .ts-k,
  .demo-bloque .ts-lbl,
  .demo-bloque .ts-sku-k,
  .demo-bloque .ts-opc-k {
    display: block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gray-blue);
  }
  .demo-bloque .ts-prods,
  .demo-bloque .ts-objs {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .demo-bloque .ts-prod {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    text-align: left;
    padding: 13px 16px;
    border: 1px solid var(--navy-12);
    background: var(--white);
    color: var(--navy);
    font-family: var(--font-sans);
    cursor: pointer;
    transition:
      background 0.28s var(--ease),
      border-color 0.28s var(--ease),
      color 0.28s var(--ease);
  }
  .demo-bloque .ts-prod:hover { border-color: var(--navy-20); }
  .demo-bloque .ts-prod.on {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--paper-warm);
  }
  .demo-bloque .ts-scan {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: var(--paper);
    color: var(--navy-60);
  }
  .demo-bloque .ts-scan svg { width: 18px; height: 18px; display: block; }
  .demo-bloque .ts-prod.on .ts-scan { background: rgba(255, 255, 255, 0.1); color: var(--paper-warm); }
  .demo-bloque .ts-prod-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .demo-bloque .ts-prod-n { font-size: 14px; font-weight: 600; line-height: 1.3; }
  .demo-bloque .ts-prod-d { font-size: 12px; color: var(--navy-60); }
  .demo-bloque .ts-prod.on .ts-prod-d { color: var(--slate-mist); }
  .demo-bloque .ts-prod-p,
  .demo-bloque .ts-sku-p,
  .demo-bloque .ts-sku-v {
    /* Cifra suelta: DM Sans, nunca el "1" de Cormorant. */
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .demo-bloque .ts-obj {
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    border: 1px solid var(--navy-12);
    border-radius: 14px;
    border-bottom-left-radius: 4px;
    background: var(--white);
    color: var(--navy);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
    cursor: pointer;
    transition:
      background 0.28s var(--ease),
      border-color 0.28s var(--ease);
  }
  .demo-bloque .ts-obj:hover { border-color: var(--navy-20); }
  .demo-bloque .ts-obj.on {
    background: var(--paper);
    border-color: var(--navy);
    box-shadow: inset 2px 0 0 var(--navy);
    font-weight: 500;
  }

  /* ---------- el panel de la herramienta ---------- */
  .demo-bloque .ts-app {
    min-width: 0;
    background: var(--white);
    border: 1px solid var(--navy-12);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 24px 60px rgba(6, 16, 28, 0.12),
      0 4px 12px rgba(6, 16, 28, 0.06);
    color: var(--navy);
  }
  .demo-bloque .ts-barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 44px;
    padding: 0 16px;
    background: var(--paper-warm);
    border-bottom: 1px solid var(--navy-12);
  }
  .demo-bloque .ts-marca {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 500;
  }
  .demo-bloque .ts-marca-o {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--navy);
    box-sizing: border-box;
  }
  .demo-bloque .ts-estado {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gray-blue);
  }
  .demo-bloque .ts-estado-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--slate); }

  .demo-bloque .ts-modos {
    display: flex;
    gap: 4px;
    padding: 12px 18px 0;
    border-bottom: 1px solid var(--navy-06);
  }
  .demo-bloque .ts-modo {
    padding: 9px 14px 11px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--navy-60);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    margin-bottom: -1px;
    transition: color 0.28s var(--ease), border-color 0.28s var(--ease);
  }
  .demo-bloque .ts-modo:hover { color: var(--navy); }
  .demo-bloque .ts-modo.on { color: var(--navy); border-bottom-color: var(--navy); }

  /* Las nueve combinaciones se apilan en la misma celda: el alto lo fija la más
     larga y el panel no salta al cambiar de producto u objeción. */
  .demo-bloque .ts-panel {
    display: grid;
    padding: 18px 18px 22px;
  }
  .demo-bloque .ts-combo {
    grid-area: 1 / 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity 0.34s var(--ease-io),
      transform 0.34s var(--ease-io);
  }
  .demo-bloque .ts-combo.on { opacity: 1; visibility: visible; transform: none; }

  .demo-bloque .ts-sku {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--navy-12);
  }
  .demo-bloque .ts-sku-v { font-size: 12px; color: var(--navy-72); letter-spacing: 0.04em; }
  .demo-bloque .ts-sku-n { font-family: var(--font-sans); font-size: 13px; color: var(--navy-72); }
  .demo-bloque .ts-sku-p { margin-left: auto; }

  .demo-bloque .ts-bub {
    font-size: 14px;
    line-height: 1.5;
    padding: 11px 15px;
    border-radius: 14px;
    max-width: 88%;
  }
  .demo-bloque .ts-bub .who {
    display: block;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 3px;
  }
  .demo-bloque .ts-bub.cli {
    align-self: flex-start;
    background: var(--paper);
    border: 1px solid var(--navy-12);
    border-bottom-left-radius: 4px;
  }
  .demo-bloque .ts-bub.ase {
    align-self: flex-end;
    background: var(--navy);
    color: var(--paper-warm);
    border-bottom-right-radius: 4px;
  }

  .demo-bloque .ts-ver {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .demo-bloque .ts-mov p {
    margin-top: 5px;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .demo-bloque .ts-porque {
    padding-left: 13px;
    border-left: 2px solid var(--slate-mist);
  }
  .demo-bloque .ts-porque p {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.58;
    color: var(--navy-72);
  }

  /* El modo decide qué se pinta: las combinaciones de Ver o la práctica. Las
     objeciones de la izquierda ceden su lugar al perfil del cliente simulado. */
  .demo-bloque .ts-wrap:not(.practicando) .ts-practica,
  .demo-bloque .ts-wrap:not(.practicando) .ts-perfiles,
  .demo-bloque .ts-wrap.practicando .ts-panel,
  .demo-bloque .ts-wrap.practicando .ts-objs-grupo { display: none; }

  /* ---------- perfil del cliente simulado ---------- */
  .demo-bloque .ts-perfil { display: none; margin-top: 12px; padding: 16px 18px; background: var(--white); border: 1px solid var(--navy-12); }
  .demo-bloque .ts-perfil.on { display: block; }
  .demo-bloque .ts-perfil-n {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .demo-bloque .ts-perfil ul { margin: 10px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .demo-bloque .ts-perfil li {
    position: relative;
    padding-left: 14px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--navy-72);
  }
  .demo-bloque .ts-perfil li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--navy-40);
  }

  /* ---------- práctica ---------- */
  .demo-bloque .ts-practica { display: flex; flex-direction: column; gap: 14px; padding: 16px 18px 22px; }
  .demo-bloque .ts-voz {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--navy-12);
  }
  .demo-bloque .ts-voz-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--paper-warm);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .demo-bloque .ts-voz-pill svg { width: 14px; height: 14px; display: block; }
  .demo-bloque .ts-voz-nota { font-size: 12px; color: var(--navy-60); }
  .demo-bloque .ts-turnos { margin-left: auto; display: inline-flex; gap: 5px; }
  .demo-bloque .ts-turnos i {
    width: 18px;
    height: 4px;
    border-radius: 2px;
    background: var(--navy-12);
    transition: background 0.28s var(--ease);
  }
  .demo-bloque .ts-turnos i.actual { background: var(--navy-40); }
  .demo-bloque .ts-turnos i.bien { background: var(--navy); }
  .demo-bloque .ts-turnos i.mal { background: var(--slate-mist); }

  /* El hilo crece hacia abajo con tope de alto; el último globo queda a la vista. */
  .demo-bloque .ts-hilo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 340px;
    overflow-y: auto;
    scroll-behavior: smooth;
    overscroll-behavior: contain;
  }
  .demo-bloque .ts-hilo .ts-bub { animation: ts-entra 0.34s var(--ease-io) both; }
  @keyframes ts-entra {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .demo-bloque .ts-bub .who { display: flex; align-items: center; gap: 8px; }
  .demo-bloque .ts-onda { display: inline-flex; align-items: center; gap: 2px; height: 10px; }
  .demo-bloque .ts-onda b { display: block; width: 2px; border-radius: 1px; background: currentColor; }
  .demo-bloque .ts-dur { font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }

  .demo-bloque .ts-turno { display: flex; flex-direction: column; gap: 12px; }
  .demo-bloque .ts-preg {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .demo-bloque .ts-opcs { display: flex; flex-direction: column; gap: 8px; }
  .demo-bloque .ts-opc-btn {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    width: 100%;
    text-align: left;
    padding: 12px 14px;
    border: 1px solid var(--navy-12);
    border-radius: 4px;
    background: var(--white);
    color: var(--navy);
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.48;
    cursor: pointer;
    transition: border-color 0.28s var(--ease);
  }
  .demo-bloque .ts-opc-btn:hover { border-color: var(--navy-40); }
  .demo-bloque .ts-opc-l {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--navy-20);
    font-size: 11px;
    font-weight: 600;
    color: var(--navy-60);
  }

  .demo-bloque .ts-coach,
  .demo-bloque .ts-final {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 14px 16px;
    background: var(--paper-warm);
    border: 1px solid var(--navy-12);
    border-radius: 4px;
  }
  .demo-bloque .ts-turno[hidden],
  .demo-bloque .ts-coach[hidden],
  .demo-bloque .ts-final[hidden],
  .demo-bloque .ts-coach-mejor[hidden] { display: none; }
  .demo-bloque .ts-coach-k {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-60);
  }
  .demo-bloque .ts-coach.bien .ts-coach-k { color: var(--petrol-deep); }
  .demo-bloque .ts-coach.bien { border-color: var(--petrol); background: var(--petrol-06); }
  .demo-bloque .ts-coach p,
  .demo-bloque .ts-coach-mejor p { font-size: 13px; line-height: 1.58; color: var(--navy-72); }
  .demo-bloque .ts-coach-mejor { padding-left: 12px; border-left: 2px solid var(--slate-mist); }
  .demo-bloque .ts-coach-mejor p { margin-top: 3px; color: var(--navy); }
  .demo-bloque .ts-final-r {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.15;
  }
  .demo-bloque .ts-final.compra { border-color: var(--petrol); background: var(--petrol-06); }
  .demo-bloque .ts-final.compra .ts-final-r { color: var(--petrol-deep); }
  .demo-bloque .ts-final-m { font-size: 13px; color: var(--navy-72); }

  .demo-bloque .ts-btn {
    margin-top: 4px;
    padding: 10px 18px;
    border-radius: var(--r);
    border: 1px solid var(--navy);
    background: var(--navy);
    color: var(--paper-warm);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.28s var(--ease);
  }
  .demo-bloque .ts-btn:hover { opacity: 0.88; }

  .demo-bloque .demo-nota {
    margin-top: 20px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--navy-40);
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-bloque .ts-combo,
    .demo-bloque .ts-prod,
    .demo-bloque .ts-obj,
    .demo-bloque .ts-modo,
    .demo-bloque .ts-opc-btn,
    .demo-bloque .ts-btn,
    .demo-bloque .ts-turnos i {
      transition: none;
    }
    .demo-bloque .ts-combo { transform: none; }
    .demo-bloque .ts-hilo { scroll-behavior: auto; }
    .demo-bloque .ts-hilo .ts-bub { animation: none; }
  }

  @media (max-width: 900px) {
    .demo-bloque .ts-wrap { grid-template-columns: 1fr; }
    .demo-bloque .ts-ctrl { gap: 22px; }
  }
  @media (max-width: 600px) {
    .demo-bloque .ts-panel { padding: 16px 14px 18px; }
    .demo-bloque .ts-modos { padding: 10px 14px 0; }
    .demo-bloque .ts-bub { max-width: 94%; }
    .demo-bloque .ts-practica { padding: 14px 14px 18px; }
    .demo-bloque .ts-turnos { margin-left: 0; }
    .demo-bloque .ts-sku-n { flex-basis: 100%; order: 3; }
  }
</style>

<script is:inline>
  // Motor de la mini-demo. Sin dependencias y sin cálculo. En Ver solo decide
  // qué combinación lleva `on`. En Practicar arma el hilo de la conversación a
  // partir del JSON de la página: cliente, respuesta elegida, reacción del
  // cliente y retroalimentación, turno por turno. Todo el texto entra con
  // textContent. No hay avance automático: el visitante maneja todo.
  (function () {
    var raices = document.querySelectorAll('[data-demo-ts]');
    for (var r = 0; r < raices.length; r++) montar(raices[r]);

    function montar(raiz) {
      var prods = raiz.querySelectorAll('[data-prod-btn]');
      var objs = raiz.querySelectorAll('[data-obj-btn]');
      var modos = raiz.querySelectorAll('[data-modo-btn]');
      var combos = raiz.querySelectorAll('.ts-combo');
      var perfiles = raiz.querySelectorAll('[data-perfil]');
      if (!prods.length || !objs.length || !combos.length) return;

      var datos = null;
      try {
        var nodo = raiz.parentNode.querySelector('[data-ts-practica]');
        datos = nodo ? JSON.parse(nodo.textContent) : null;
      } catch (e) {}

      var p = 0;
      var o = 0;
      var modo = 'ver';

      var q = function (sel) { return raiz.querySelector(sel); };
      var hilo = q('[data-hilo]');
      var turnoBox = q('[data-turno]');
      var preg = q('[data-preg]');
      var opcsBox = q('[data-opcs]');
      var coach = q('[data-coach]');
      var coachK = q('[data-coach-k]');
      var coachNota = q('[data-coach-nota]');
      var coachMejor = q('[data-coach-mejor]');
      var coachMejorT = q('[data-coach-mejor-t]');
      var seguir = q('[data-seguir]');
      var fin = q('[data-final]');
      var finR = q('[data-final-r]');
      var finM = q('[data-final-m]');
      var otra = q('[data-otra]');
      var ticks = raiz.querySelectorAll('[data-turnos] i');

      // Estado de la práctica.
      var t = 0;
      var aciertos = 0;

      function marcar(lista, attr, valor) {
        for (var i = 0; i < lista.length; i++) {
          var activo = lista[i].getAttribute(attr) === String(valor);
          lista[i].classList.toggle('on', activo);
          if (lista[i].tagName === 'BUTTON') lista[i].setAttribute('aria-pressed', activo ? 'true' : 'false');
        }
      }

      function el(tag, cls, txt) {
        var n = document.createElement(tag);
        if (cls) n.className = cls;
        if (txt != null) n.textContent = txt;
        return n;
      }

      // Onda de voz decorativa; alturas fijas a partir del texto para que no
      // cambie entre visitas.
      function onda(texto) {
        var w = el('span', 'ts-onda');
        w.setAttribute('aria-hidden', 'true');
        for (var i = 0; i < 9; i++) {
          var b = el('b');
          var c = texto.charCodeAt((i * 7) % texto.length) || 0;
          b.style.height = 3 + (c % 8) + 'px';
          w.appendChild(b);
        }
        return w;
      }

      function globo(quien, texto, dur) {
        var cli = quien === 'cli';
        var g = el('div', 'ts-bub ' + quien);
        var who = el('span', 'who');
        who.appendChild(document.createTextNode(cli ? datos.quien_cliente : datos.quien_asesor));
        who.appendChild(onda(texto));
        if (dur) who.appendChild(el('span', 'ts-dur', dur));
        g.appendChild(who);
        g.appendChild(document.createTextNode(texto));
        hilo.appendChild(g);
        hilo.scrollTop = hilo.scrollHeight;
      }

      function cliente() { return datos.clientes[p] || datos.clientes[0]; }

      function mostrarTurno() {
        var turno = cliente().turnos[t];
        globo('cli', turno.cliente, turno.dur);
        preg.textContent = datos.pregunta + ' · ' + datos.turno_label + ' ' + (t + 1) + ' ' + datos.de + ' ' + cliente().turnos.length;
        opcsBox.textContent = '';
        turno.opciones.forEach(function (op, k) {
          var b = el('button', 'ts-opc-btn');
          b.type = 'button';
          b.appendChild(el('span', 'ts-opc-l', 'ABC'.charAt(k)));
          b.appendChild(el('span', 'ts-opc-t', op.texto));
          b.addEventListener('click', function () { responder(op, turno); });
          opcsBox.appendChild(b);
        });
        turnoBox.hidden = false;
        coach.hidden = true;
        for (var i = 0; i < ticks.length; i++) ticks[i].classList.toggle('actual', i === t);
      }

      function responder(op, turno) {
        turnoBox.hidden = true;
        globo('ase', op.texto, null);
        globo('cli', op.reaccion, null);
        if (op.buena) aciertos++;
        ticks[t] && ticks[t].classList.remove('actual');
        ticks[t] && ticks[t].classList.add(op.buena ? 'bien' : 'mal');
        coach.classList.toggle('bien', !!op.buena);
        coachK.textContent = op.buena ? datos.nota_buena : datos.nota_mala;
        coachNota.textContent = op.nota;
        var mejor = null;
        turno.opciones.forEach(function (x) { if (x.buena) mejor = x; });
        coachMejor.hidden = !!op.buena || !mejor;
        if (mejor) coachMejorT.textContent = mejor.texto;
        var ultimo = t >= cliente().turnos.length - 1;
        seguir.textContent = ultimo ? datos.btn_resultado : datos.btn_seguir;
        coach.hidden = false;
      }

      function cerrar() {
        coach.hidden = true;
        var total = cliente().turnos.length;
        var r = aciertos >= total ? 'compra' : aciertos === total - 1 ? 'duda' : 'se_va';
        globo('cli', cliente().cierre[r], null);
        fin.classList.toggle('compra', r === 'compra');
        finR.textContent = datos.resultados[r];
        finM.textContent = datos.marcador.replace('{n}', aciertos).replace('{t}', total);
        fin.hidden = false;
      }

      function iniciar() {
        if (!datos || !hilo) return;
        t = 0;
        aciertos = 0;
        hilo.textContent = '';
        fin.hidden = true;
        for (var i = 0; i < ticks.length; i++) ticks[i].className = '';
        mostrarTurno();
      }

      if (seguir)
        seguir.addEventListener('click', function () {
          if (t >= cliente().turnos.length - 1) return cerrar();
          t++;
          mostrarTurno();
        });
      if (otra)
        otra.addEventListener('click', function () {
          iniciar();
          var b = opcsBox.querySelector('button');
          if (b) b.focus();
        });

      function pintar() {
        marcar(prods, 'data-prod-btn', p);
        marcar(objs, 'data-obj-btn', o);
        marcar(modos, 'data-modo-btn', modo);
        marcar(perfiles, 'data-perfil', p);
        raiz.classList.toggle('practicando', modo === 'practicar');
        for (var i = 0; i < combos.length; i++) {
          var c = combos[i];
          c.classList.toggle('on', c.getAttribute('data-p') === String(p) && c.getAttribute('data-o') === String(o));
        }
      }

      function enlazar(lista, fn) {
        for (var i = 0; i < lista.length; i++) lista[i].addEventListener('click', fn);
      }
      enlazar(prods, function () {
        p = parseInt(this.getAttribute('data-prod-btn'), 10) || 0;
        pintar();
        // Otro producto es otro cliente: la práctica empieza de nuevo.
        if (modo === 'practicar') iniciar();
      });
      enlazar(objs, function () {
        o = parseInt(this.getAttribute('data-obj-btn'), 10) || 0;
        pintar();
      });
      enlazar(modos, function () {
        var antes = modo;
        modo = this.getAttribute('data-modo-btn') === 'practicar' && datos ? 'practicar' : 'ver';
        pintar();
        if (modo === 'practicar' && antes !== 'practicar') iniciar();
      });

      // Parámetro de QA: ?demo=<producto>-<objeción>[-p] (1 = el primero) fija
      // la combinación y, con -p, abre la práctica. No cambia nada para quien
      // navega el sitio.
      try {
        var v = new URLSearchParams(window.location.search).get('demo');
        if (v) {
          var partes = v.split('-');
          var qp = parseInt(partes[0], 10);
          var qo = parseInt(partes[1], 10);
          if (!isNaN(qp)) p = Math.max(0, Math.min(prods.length - 1, qp - 1));
          if (!isNaN(qo)) o = Math.max(0, Math.min(objs.length - 1, qo - 1));
          if (partes[2] === 'p' && datos) modo = 'practicar';
        }
      } catch (e) {}

      pintar();
      if (modo === 'practicar') iniciar();
    }
  })();
</script>
