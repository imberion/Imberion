---
// Vista de la herramienta para la página de Floor Signal en ropa y calzado (2026-11-01): el tablero
// semanal que recibe la tienda, en cuatro recuadros (Rodrigo recortó venta cruzada, perfiles y probador), dibujado en HTML con las cifras de la tienda de ejemplo. Todo sale
// del contenido (src/i18n/content/floor-signal-moda.json, clave `tablero`); las cifras cuadran con el
// resto de la página (1,000 entran, 610 atendidos, 140 compran, ticket promedio de $1,250).
// Fundamento de cada recuadro: 00_imberion/tooling/floor_signal/_spec_floor_signal.md §15.3 a §15.6.

interface Props { contenido: Record<string, any> }
const { contenido: t } = Astro.props;
const fmt = (n: number) => n.toLocaleString('es-MX');
const maxEmbudo = t.embudo[0][1];
const maxClientes = Math.max(...t.clientes);
const pico = t.clientes.indexOf(maxClientes);
const maxFalt = Math.max(...t.faltantes.map((f: any) => f[1]));
---

<div class="vfs" role="img" aria-label={`${t.app}. ${t.embudo_k}: ${t.embudo.map((e: any) => `${e[0]} ${fmt(e[1])}`).join(', ')}.`}>
  <div class="vfs-barra">
    <span class="vfs-app">{t.app}</span>
    <span class="vfs-tabs">{t.vistas.map((v: string, i: number) => <span class={i === 0 ? 'on' : ''}>{v}</span>)}</span>
    <span class="vfs-sem">{t.semana}</span>
  </div>

  <div class="vfs-rejilla" aria-hidden="true">
    <section class="vfs-c vfs-embudo">
      <h4>{t.embudo_k}</h4>
      {t.embudo.map((e: any) => (
        <div class="vfs-emb">
          <span class="vfs-emb-l">{e[0]}</span>
          <span class="vfs-emb-b"><i style={`width:${Math.max(3, (e[1] / maxEmbudo) * 100)}%`}></i></span>
          <b>{fmt(e[1])}</b>
          <small>{e[2]}</small>
        </div>
      ))}
    </section>

    <section class="vfs-c">
      <h4>{t.faltantes_k}</h4>
      {t.faltantes.map((f: any) => (
        <div class="vfs-bar"><span>{f[0]}</span><span class="vfs-b"><i style={`width:${(f[1] / maxFalt) * 100}%`}></i></span><b>{f[1]}</b></div>
      ))}
      <p class="vfs-pie">{t.faltantes_u}</p>
    </section>



    <section class="vfs-c">
      <h4>{t.hora_k}</h4>
      <div class="vfs-horas">
        {t.horas.map((h: string, i: number) => (
          <div class={`vfs-hora ${i === pico ? 'pico' : ''}`}>
            <span class="vfs-h-b"><i style={`height:${(t.clientes[i] / maxClientes) * 100}%`}></i></span>
            <b>{t.clientes[i]}</b>
            <span class="vfs-vend">{Array.from({ length: t.vendedores }).map(() => <i></i>)}</span>
            <small>{h}</small>
          </div>
        ))}
      </div>
      <p class="vfs-pie">{t.hora_pie}</p>
    </section>


    <section class="vfs-c vfs-pasos">
      <h4>{t.pasos_k}</h4>
      <table>
        <thead><tr>{t.pasos_cols.map((c: string) => <th>{c}</th>)}</tr></thead>
        <tbody>{t.pasos.map((f: any, i: number) => <tr class={i === 1 ? 'resalta' : ''}>{f.map((x: string) => <td>{x || '·'}</td>)}</tr>)}</tbody>
      </table>
      {t.pasos_pie && <p class="vfs-pie">{t.pasos_pie}</p>}
    </section>
  </div>
</div>

<style>
  .vfs { background: #fff; border-radius: 6px; box-shadow: 0 1px 0 var(--navy-12), 0 18px 40px rgba(14, 30, 48, 0.12); overflow: hidden; font-family: var(--font-sans); color: var(--navy); }
  .vfs-barra { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 10px 16px; background: var(--navy); color: #fff; font-size: 12.5px; }
  .vfs-app { font-weight: 600; letter-spacing: 0.02em; }
  .vfs-tabs { display: flex; gap: 4px; }
  .vfs-tabs span { padding: 3px 9px; border-radius: 3px; color: var(--white-65); border: 1px solid var(--white-12); }
  .vfs-tabs span.on { background: var(--petrol-bright); color: var(--navy); border-color: var(--petrol-bright); font-weight: 600; }
  .vfs-sem { margin-left: auto; color: var(--white-65); }

  .vfs-rejilla { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 1px; background: var(--navy-08); }
  .vfs-c { background: #fff; padding: 10px 14px; min-width: 0; }
  .vfs-c h4 { margin: 0 0 8px; font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #6b737d; font-weight: 600; }
  tr.resalta td { background: var(--petrol-06); font-weight: 600; }
  .vfs-c h5 { margin: 10px 0 6px; font-size: 11.5px; font-weight: 600; color: var(--navy); }
  .vfs-embudo { grid-column: span 2; }
  .vfs-pasos { grid-column: span 2; }

  .vfs-emb { display: grid; grid-template-columns: 150px 1fr 58px 150px; align-items: center; gap: 10px; font-size: 13px; margin: 3px 0; }
  .vfs-emb-b { height: 13px; background: var(--petrol-06); }
  .vfs-emb-b i { display: block; height: 100%; background: var(--petrol); }
  .vfs-emb b { font-size: 16px; text-align: right; font-variant-numeric: tabular-nums; }
  .vfs-emb small { color: #6b737d; font-size: 12px; }

  .vfs-bar { display: grid; grid-template-columns: 1fr 70px 26px; align-items: center; gap: 8px; font-size: 12.5px; margin: 4px 0; }
  .vfs-b { height: 8px; background: var(--navy-06); }
  .vfs-b i { display: block; height: 100%; background: var(--ochre); }
  .vfs-bar b { text-align: right; font-variant-numeric: tabular-nums; }
  .vfs-pie { margin: 8px 0 0; font-size: 11.5px; line-height: 1.4; color: #4a535e; }


  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th { text-align: right; font-weight: 600; color: #6b737d; font-size: 10.5px; padding: 0 0 4px 6px; }
  th:first-child, td:first-child { text-align: left; padding-left: 0; }
  td { text-align: right; padding: 2px 0 2px 6px; border-top: 1px solid var(--navy-06); font-variant-numeric: tabular-nums; }


  .vfs-horas { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; align-items: end; }
  .vfs-hora { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 11px; }
  .vfs-h-b { display: flex; align-items: flex-end; height: 50px; width: 18px; }
  .vfs-h-b i { display: block; width: 100%; background: #9aa3ad; }
  .vfs-hora.pico .vfs-h-b i { background: var(--petrol); }
  .vfs-hora b { font-size: 11.5px; font-variant-numeric: tabular-nums; }
  .vfs-hora small { font-size: 10.5px; color: #6b737d; }
  .vfs-hora.pico small { color: var(--navy); font-weight: 700; }
  .vfs-vend { display: flex; gap: 2px; }
  .vfs-vend i { width: 6px; height: 6px; border-radius: 50%; background: var(--navy); }

  @media (min-width: 961px) and (max-height: 960px) {
    .vfs-barra { padding: 7px 14px; }
    .vfs-c { padding: 7px 12px; }
    .vfs-c h4 { margin-bottom: 5px; }
  .vfs-c h5 { margin: 6px 0 4px; }
    table { font-size: 11.5px; }
    td { padding: 1px 0 1px 6px; }
    .vfs-pie { margin-top: 5px; }
  }
  @media (max-width: 960px) {
    .vfs-rejilla { grid-template-columns: 1fr; }
    .vfs-embudo, .vfs-pasos { grid-column: auto; }
    .vfs-emb { grid-template-columns: 1fr 52px; }
    .vfs-emb-b { grid-column: 1 / -1; order: 3; }
    .vfs-emb small { grid-column: 1 / -1; order: 4; }
    .vfs-sem { margin-left: 0; }
  }
</style>
