  .demo-bloque .arch-foot .fk { font-family: var(--font-sans); font-size: 13.5px; font-weight: 600; color: var(--navy); margin-bottom: 5px; }
  .demo-bloque .arch-foot .fv { font-size: 13px; line-height: 1.6; color: var(--navy-72); }
