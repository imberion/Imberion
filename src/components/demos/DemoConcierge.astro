<script is:inline>
  // Motor de la mini-demo. Sin dependencias: revela los elementos cuyo
  // `data-step` ya pasó. Si nadie interactúa, avanza solo cada 2.5 s; en
  // cuanto alguien toca un botón el avance automático se apaga.
  (function () {
    var raices = document.querySelectorAll('[data-demo-concierge]');
    for (var r = 0; r < raices.length; r++) montar(raices[r]);

    function montar(raiz) {
      var items = raiz.querySelectorAll('.demo-ai');
      var btnNext = raiz.querySelector('[data-demo-next]');
      var btnReset = raiz.querySelector('[data-demo-reset]');
      var contador = raiz.querySelector('[data-demo-count]');
      var max = parseInt(raiz.getAttribute('data-max'), 10) || 0;
      if (!items.length || !max) return;

      var quieto =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Arranca con el primer mensaje ya puesto: tres tarjetas vacías son una
      // mala primera impresión mientras corre el primer intervalo.
      var INICIO = 1;
      var paso = INICIO;
      var timer = null;
      var pausado = false;
      var automatico = !quieto;

      // Parámetro de QA: ?demo=<paso> congela la demo en ese paso para poder
      // capturarla. No cambia nada para quien navega el sitio.
      var qa = null;
      try {
        var v = new URLSearchParams(window.location.search).get('demo');
        if (v !== null && v !== '') {
          var n = parseInt(v, 10);
          if (!isNaN(n)) qa = Math.max(0, Math.min(max, n));
        }
      } catch (e) {
        qa = null;
      }

      function dosDigitos(n) {
        return (n < 10 ? '0' : '') + n;
      }

      function pintar() {
        for (var i = 0; i < items.length; i++) {
          var s = parseInt(items[i].getAttribute('data-step'), 10) || 0;
          if (s <= paso) items[i].classList.add('shown');
          else items[i].classList.remove('shown');
        }
        if (contador) contador.textContent = dosDigitos(paso) + ' / ' + dosDigitos(max);
      }

      function avanzar() {
        if (paso < max) {
          paso++;
          pintar();
          return true;
        }
        return false;
      }

      function detener() {
        automatico = false;
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      function arrancar() {
        if (!automatico || timer) return;
        timer = setInterval(function () {
          if (pausado) return;
          if (!avanzar()) detener();
        }, 2500);
      }

      if (btnNext)
        btnNext.addEventListener('click', function () {
          detener();
          if (!avanzar()) {
            paso = INICIO;
            pintar();
          }
        });
      if (btnReset)
        btnReset.addEventListener('click', function () {
          detener();
          paso = INICIO;
          pintar();
        });

      raiz.addEventListener('mouseenter', function () {
        pausado = true;
      });
      raiz.addEventListener('mouseleave', function () {
        pausado = false;
      });
      raiz.addEventListener('focusin', function () {
        pausado = true;
      });

      if (qa !== null) {
        detener();
        paso = qa;
        pintar();
        return;
      }

      if (quieto) {
        paso = max;
        pintar();
        return;
      }

      pintar();

      // No arranca hasta que el bloque está a la vista: si arrancara al cargar,
      // la conversación terminaría antes de que alguien llegue a leerla.
      if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(
          function (entradas) {
            for (var i = 0; i < entradas.length; i++) {
              if (entradas[i].isIntersecting) {
                arrancar();
                obs.disconnect();
              }
            }
          },
          { threshold: 0.25 }
        );
        obs.observe(raiz);
      } else {
        arrancar();
      }
    }
  })();
</script>
