---
// Mini-demo de Concierge: la arquitectura de tres capas (front omnicanal →
// cerebro → acciones) narrada paso a paso.
//
// Portada del componente `ARCH` de
// 00_imberion/comercial/concierge/_build.py (chasis de deck): misma secuencia,
// mismos 12 `data-step`, mismos tres momentos (queja y reposición → venta
// cruzada con lealtad → cierre). Lo que cambia es el chasis: aquí no hay
// presentador que avance la lámina, así que el control es un par de botones y,
// si nadie toca nada, un avance automático suave.
//
// Concierge SÍ enseña su arquitectura: decisión comercial registrada en
// 00_imberion/comercial/concierge/README.md. No se uniforma con otras fichas.
//
// El contenedor lleva `data-dialogo` porque los globos son habla citada entre
// un cliente y el servicio de atención: ahí la segunda persona es del
// personaje, no del sitio, y el grep de segunda persona debe excluir el bloque.

export interface DemoConciergeContenido {
  titulo: string;
  intro: string;
  capas: Array<{ num: string; label: string }>;
  globos: Array<{ paso: number; lado: 'cli' | 'bot'; quien: string; texto: string }>;
  senales: Array<{ paso: number; clave: string; valor: string; vp?: boolean }>;
  acciones: Array<{ paso: number; texto: string; soft?: boolean }>;
  pie: Array<{ k: string; v: string }>;
  paso_label: string;
  btn_siguiente: string;
  btn_reiniciar: string;
  simulacion: string;
}

interface Props {
  contenido: DemoConciergeContenido;
}

const { contenido: d } = Astro.props;

const pasos = [
  ...d.globos.map((g) => g.paso),
  ...d.senales.map((s) => s.paso),
  ...d.acciones.map((a) => a.paso),
];
const maxPaso = Math.max(...pasos);

// Glifos de canal del front omnicanal (voz, WhatsApp, correo, SMS, Instagram,
// TikTok, LinkedIn, Facebook). Monocromos, heredados del material comercial:
// marcas reales, nada de iconografía de juguete.
const canales = [
  {
    n: 'Voz',
    d: '<path d="M6.6 3.5c.5 0 .9.3 1 .8l.8 3c.12.5-.05 1-.45 1.3L6.5 9.9a12 12 0 0 0 5.6 5.6l1.3-1.45c.3-.4.8-.55 1.3-.45l3 .8c.5.12.8.5.8 1V19c0 1.1-.9 2-2 2A15 15 0 0 1 4 6.5c0-1.1.9-2 2-2z"/>',
    fill: true,
  },
  {
    n: 'WhatsApp',
    d: '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.2A9 9 0 1 0 12 3zm0 1.9a7.1 7.1 0 1 1-3.7 13.2l-.3-.2-2.5.65.66-2.4-.2-.3A7.1 7.1 0 0 1 12 4.9z"/><path d="M9.3 7.9c.18 0 .38.01.54.4l.6 1.45c.08.2.02.42-.1.55l-.45.55c.5 1 1.3 1.7 2.3 2.2l.55-.6c.13-.16.34-.2.52-.12l1.45.6c.3.13.4.32.4.55.02 1-.85 1.75-1.8 1.65A6.1 6.1 0 0 1 8 9.5c-.1-.85.45-1.6 1.3-1.6z" fill="var(--paper-warm)"/>',
    fill: true,
  },
  {
    n: 'Correo',
    d: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 7l8.5 6 8.5-6"/>',
    fill: false,
  },
  {
    n: 'SMS',
    d: '<path d="M4 5h16v11H9l-4 3v-3H4z"/><circle cx="9" cy="10.5" r=".9" fill="currentColor" stroke="none"/><circle cx="12" cy="10.5" r=".9" fill="currentColor" stroke="none"/><circle cx="15" cy="10.5" r=".9" fill="currentColor" stroke="none"/>',
    fill: false,
  },
  {
    n: 'Instagram',
    d: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>',
    fill: false,
  },
  {
    n: 'TikTok',
    d: '<path d="M14.2 3c.32 2.2 1.6 3.7 3.8 3.95v2.5c-1.3.08-2.5-.3-3.8-1.05V15a5.2 5.2 0 1 1-5.2-5.2c.3 0 .6.02.9.07v2.6a2.6 2.6 0 1 0 1.8 2.5V3h2.5z"/>',
    fill: true,
  },
  {
    n: 'LinkedIn',
    d: '<rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M8 10.6v6"/><path d="M8 7.6v.01"/><path d="M12 16.6v-3.4a2 2 0 0 1 4 0v3.4"/><path d="M12 16.6v-6"/>',
    fill: false,
  },
  {
    n: 'Facebook',
    d: '<path d="M13.6 21v-7h2.35l.42-2.75h-2.77V9.45c0-.8.22-1.34 1.36-1.34l1.5-.01V5.66c-.26-.03-1.16-.11-2.2-.11-2.18 0-3.67 1.33-3.67 3.77v2.1H8.2V14h2.4v7h3z"/>',
    fill: true,
  },
];
---

<section class="demo-bloque" id="mini-demo">
  <div class="container">
    <div class="demo-head">
      <div>
        <div class="eyebrow demo-eyebrow">{d.capas.map((c) => c.label).join(' · ')}</div>
        <h2>{d.titulo}</h2>
        <p class="cuerpo">{d.intro}</p>
      </div>
    </div>

    <div
      class="arch-wrap"
      data-dialogo
      data-demo-concierge
      data-max={maxPaso}
      role="group"
      aria-label={d.titulo}
    >
      <div class="arch">
        <div class="arch-col">
          <div class="arch-head">
            <span class="arch-num">{d.capas[0].num}</span>
            <span class="arch-label">{d.capas[0].label}</span>
          </div>
          <div class="arch-in">
            <div class="arch-channels">
              {
                canales.map((c) => (
                  <span class="arch-ch">
                    <svg
                      viewBox="0 0 24 24"
                      role="img"
                      aria-label={c.n}
                      fill={c.fill ? 'currentColor' : 'none'}
                      stroke={c.fill ? 'none' : 'currentColor'}
                      stroke-width="1.5"
                      stroke-linejoin="round"
                      set:html={c.d}
                    />
                  </span>
                ))
              }
            </div>
            <div class="arch-chat">
              {
                d.globos.map((g) => (
                  <div class={`arch-bub ${g.lado} demo-ai`} data-step={g.paso}>
                    <span class="who">{g.quien}</span>
                    {g.texto}
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="arch-arrow" aria-hidden="true">→</div>

        <div class="arch-col hot">
          <div class="arch-head">
            <span class="arch-num">{d.capas[1].num}</span>
            <span class="arch-label">{d.capas[1].label}</span>
            <span class="arch-proc" aria-hidden="true"></span>
          </div>
          <div class="arch-in">
            {
              d.senales.map((s) => (
                <div class={`arch-tag demo-ai${s.vp ? ' vp' : ''}`} data-step={s.paso}>
                  <span class="tk">{s.clave}</span>
                  <span class="tv">{s.valor}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="arch-arrow" aria-hidden="true">→</div>

        <div class="arch-col">
          <div class="arch-head">
            <span class="arch-num">{d.capas[2].num}</span>
            <span class="arch-label">{d.capas[2].label}</span>
          </div>
          <div class="arch-in">
            {
              d.acciones.map((a) => (
                <div class={`arch-act demo-ai${a.soft ? ' soft' : ''}`} data-step={a.paso}>
                  <span class="ck" aria-hidden="true">
                    ✓
                  </span>
                  {a.texto}
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="arch-ctrl">
        <button type="button" class="arch-btn" data-demo-next>
          {d.btn_siguiente}
          <span class="arch-btn-arrow" aria-hidden="true">→</span>
        </button>
        <button type="button" class="arch-btn arch-btn--ghost" data-demo-reset>
          {d.btn_reiniciar}
        </button>
        <span class="arch-step" aria-live="polite">
          <span class="arch-step-k">{d.paso_label}</span>
          <span class="arch-step-n" data-demo-count>{`00 / ${String(maxPaso).padStart(2, '0')}`}</span>
        </span>
      </div>

      <div class="arch-foot">
        {
          d.pie.map((f) => (
            <div class="arch-fitem">
              <div class="fk">{f.k}</div>
              <div class="fv">{f.v}</div>
            </div>
          ))
        }
      </div>
    </div>

    <p class="demo-nota">{d.simulacion}</p>
  </div>
</section>

<style is:inline>
  /* Tokens del sitio (site.css / shell.css). Monocromo navy sobre papel: sin
     petróleo, sin ochre y sin verde. La paloma de las acciones va en navy. */
  .demo-bloque {
    /* La barra superior es fija: sin este margen, un salto a #mini-demo deja el
       encabezado del bloque debajo de la barra. */
    scroll-margin-top: 86px;
    padding: clamp(70px, 6.5vw, 150px) 0;
    background: var(--paper-warm);
    border-top: 1px solid var(--navy-12);
    border-bottom: 1px solid var(--navy-12);
  }
  .demo-bloque .demo-head h2 {
    font-family: var(--font-serif);
    font-weight: 300;
    line-height: 1.12;
    font-size: clamp(1.9rem, 3.2vw, 3.4rem);
    max-width: 22ch;
    margin-top: 12px;
  }
  .demo-bloque .demo-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
  }
  .demo-bloque .demo-head .cuerpo {
    margin-top: 20px;
    max-width: 66ch;
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--navy-72);
  }

  /* ---------- las tres capas ---------- */
  .demo-bloque .arch-wrap {
    margin-top: 46px;
    position: relative;
  }
  .demo-bloque .arch {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 12px;
  }
  .demo-bloque .arch-col {
    background: var(--white);
    border: 1px solid var(--navy-12);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .demo-bloque .arch-col.hot {
    border-top: 2px solid var(--navy);
    box-shadow: 0 4px 18px rgba(10, 24, 40, 0.06);
  }
  .demo-bloque .arch-head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--navy-06);
    background: var(--paper-warm);
  }
  .demo-bloque .arch-num {
    /* Cifra suelta: DM Sans, nunca el "1" de Cormorant. */
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--gray-blue);
    font-variant-numeric: tabular-nums;
  }
  .demo-bloque .arch-label {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1;
  }
  .demo-bloque .arch-proc {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--slate-soft);
    margin-left: auto;
  }
  .demo-bloque .arch-in {
    padding: 16px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .demo-bloque .arch-channels {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 5px;
    color: var(--navy);
  }
  .demo-bloque .arch-ch {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    border: 1px solid var(--navy-12);
    background: var(--paper-warm);
    border-radius: 3px;
  }
  .demo-bloque .arch-ch svg {
    width: 15px;
    height: 15px;
    display: block;
  }

  .demo-bloque .arch-chat {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 4px;
  }
  .demo-bloque .arch-bub {
    font-size: 13px;
    line-height: 1.42;
    padding: 9px 12px;
    border-radius: 9px;
    max-width: 92%;
  }
  .demo-bloque .arch-bub.cli {
    align-self: flex-start;
    background: var(--paper);
    border: 1px solid var(--navy-12);
    border-bottom-left-radius: 2px;
    color: var(--navy);
  }
  .demo-bloque .arch-bub.bot {
    align-self: flex-end;
    background: var(--navy);
    color: var(--paper-warm);
    border-bottom-right-radius: 2px;
  }
  .demo-bloque .arch-bub .who {
    display: block;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 3px;
  }

  .demo-bloque .arch-tag {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 12px;
    background: var(--paper);
    border-left: 2px solid var(--slate-soft);
  }
  .demo-bloque .arch-tag.vp {
    border-left-color: var(--navy);
    background: var(--paper-alt);
  }
  .demo-bloque .arch-tag .tk {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray-blue);
  }
  .demo-bloque .arch-tag .tv {
    font-size: 13px;
    line-height: 1.4;
    color: var(--navy);
  }

  .demo-bloque .arch-act {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    font-size: 13px;
    line-height: 1.42;
    color: var(--navy);
  }
  .demo-bloque .arch-act .ck {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-size: 10px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .demo-bloque .arch-act.soft {
    color: var(--navy-60);
  }
  .demo-bloque .arch-act.soft .ck {
    background: var(--slate-mist);
    color: var(--navy);
  }

  .demo-bloque .arch-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: var(--slate);
  }

  /* ---------- control ---------- */
  .demo-bloque .arch-ctrl {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
    flex-wrap: wrap;
  }
  .demo-bloque .arch-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 20px;
    border-radius: var(--r);
    border: 1px solid var(--navy);
    background: var(--navy);
    color: var(--paper-warm);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      background 0.28s var(--ease),
      color 0.28s var(--ease),
      border-color 0.28s var(--ease);
  }
  .demo-bloque .arch-btn:hover {
    background: var(--navy-soft);
    border-color: var(--navy-soft);
  }
  .demo-bloque .arch-btn .arch-btn-arrow {
    display: inline-block;
    transition: transform 0.35s var(--ease);
  }
  .demo-bloque .arch-btn:hover .arch-btn-arrow {
    transform: translateX(4px);
  }
  .demo-bloque .arch-btn--ghost {
    background: transparent;
    color: var(--navy);
    border-color: var(--navy-20);
  }
  .demo-bloque .arch-btn--ghost:hover {
    background: transparent;
    border-color: var(--navy);
    color: var(--navy);
  }
  .demo-bloque .arch-step {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin-left: auto;
  }
  .demo-bloque .arch-step-k {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gray-blue);
  }
  .demo-bloque .arch-step-n {
    /* Cifras sueltas: DM Sans con anchos tabulares para que no salte. */
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--navy);
  }

  /* ---------- pie ---------- */
  .demo-bloque .arch-foot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    padding-top: 22px;
    margin-top: 24px;
    border-top: 1px solid var(--navy-12);
  }
  .demo-bloque .arch-foot .fk {
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 5px;
  }
  .demo-bloque .arch-foot .fv {
    font-size: 13px;
    line-height: 1.6;
    color: var(--navy-72);
  }

  .demo-bloque .demo-nota {
    margin-top: 20px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--navy-40);
  }

  /* ---------- secuencia paso a paso ---------- */
  /* Mismo mecanismo que el material comercial: cada elemento declara su
     `data-step` y el motor le pone `.shown`. */
  .demo-bloque .demo-ai {
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity 0.45s var(--ease-io),
      transform 0.45s var(--ease-io);
  }
  .demo-bloque .demo-ai.shown {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Todo visible y sin movimiento, como la versión impresa. */
    .demo-bloque .demo-ai {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .arch-btn,
    .demo-bloque .arch-btn .arch-btn-arrow {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    /* Las tres columnas se apilan en orden front → cerebro → acciones. */
    .demo-bloque .arch {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .demo-bloque .arch-arrow {
      transform: rotate(90deg);
      font-size: 16px;
      padding: 2px 0;
    }
    .demo-bloque .arch-step {
      margin-left: 0;
    }
  }
</style>

<script is:inline>
  // Motor de la mini-demo. Sin dependencias: revela los elementos cuyo
  // `data-step` ya pasó. Si nadie interactúa, avanza solo cada 2.5 s; en
  // cuanto alguien toca un botón el avance automático se apaga.
  (function () {
    var raices = document.querySelectorAll('[data-demo-concierge]');
    for (var r = 0; r < raices.length; r++) montar(raices[r]);

    function montar(raiz) {
      var items = raiz.querySelectorAll('.demo-ai');
      var btnNext = raiz.querySelector('[data-demo-next]');
      var btnReset = raiz.querySelector('[data-demo-reset]');
      var contador = raiz.querySelector('[data-demo-count]');
      var max = parseInt(raiz.getAttribute('data-max'), 10) || 0;
      if (!items.length || !max) return;

      var quieto =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Arranca con el primer mensaje ya puesto: tres tarjetas vacías son una
      // mala primera impresión mientras corre el primer intervalo.
      var INICIO = 1;
      var paso = INICIO;
      var timer = null;
      var pausado = false;
      var automatico = !quieto;

      // Parámetro de QA: ?demo=<paso> congela la demo en ese paso para poder
      // capturarla. No cambia nada para quien navega el sitio.
      var qa = null;
      try {
        var v = new URLSearchParams(window.location.search).get('demo');
        if (v !== null && v !== '') {
          var n = parseInt(v, 10);
          if (!isNaN(n)) qa = Math.max(0, Math.min(max, n));
        }
      } catch (e) {
        qa = null;
      }

      function dosDigitos(n) {
        return (n < 10 ? '0' : '') + n;
      }

      function pintar() {
        for (var i = 0; i < items.length; i++) {
          var s = parseInt(items[i].getAttribute('data-step'), 10) || 0;
          if (s <= paso) items[i].classList.add('shown');
          else items[i].classList.remove('shown');
        }
        if (contador) contador.textContent = dosDigitos(paso) + ' / ' + dosDigitos(max);
      }

      function avanzar() {
        if (paso < max) {
          paso++;
          pintar();
          return true;
        }
        return false;
      }

      function detener() {
        automatico = false;
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      function arrancar() {
        if (!automatico || timer) return;
        timer = setInterval(function () {
          if (pausado) return;
          if (!avanzar()) detener();
        }, 2500);
      }

      if (btnNext)
        btnNext.addEventListener('click', function () {
          detener();
          if (!avanzar()) {
            paso = INICIO;
            pintar();
          }
        });
      if (btnReset)
        btnReset.addEventListener('click', function () {
          detener();
          paso = INICIO;
          pintar();
        });

      raiz.addEventListener('mouseenter', function () {
        pausado = true;
      });
      raiz.addEventListener('mouseleave', function () {
        pausado = false;
      });
      raiz.addEventListener('focusin', function () {
        pausado = true;
      });

      if (qa !== null) {
        detener();
        paso = qa;
        pintar();
        return;
      }

      if (quieto) {
        paso = max;
        pintar();
        return;
      }

      pintar();

      // No arranca hasta que el bloque está a la vista: si arrancara al cargar,
      // la conversación terminaría antes de que alguien llegue a leerla.
      if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(
          function (entradas) {
            for (var i = 0; i < entradas.length; i++) {
              if (entradas[i].isIntersecting) {
                arrancar();
                obs.disconnect();
              }
            }
          },
          { threshold: 0.25 }
        );
        obs.observe(raiz);
      } else {
        arrancar();
      }
    }
  })();
</script>
